		this.createFilenamePrefix = createFilenamePrefix;
	}

	public String getAmendFilesnamePrefix() {
		return amendFilesnamePrefix;
	}

	public void setAmendFilesnamePrefix(String amendFilesnamePrefix) {
		this.amendFilesnamePrefix = amendFilesnamePrefix;
	}

	public String getCancelFilesnamePrefix() {
		return cancelFilesnamePrefix;
	}

	public void setCancelFilesnamePrefix(String cancelFilesnamePrefix) {
		this.cancelFilesnamePrefix = cancelFilesnamePrefix;
	}

	public String getMandatePostfix() {
		return mandatePostfix;
	}

	public void setMandatePostfix(String mandatePostfix) {
		this.mandatePostfix = mandatePostfix;
	}

}




