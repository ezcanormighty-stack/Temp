	}

	public void setMmsFilenamePrefix(String mmsFilenamePrefix) {
		this.mmsFilenamePrefix = mmsFilenamePrefix;
	}

	public String getMmsFilenameSuffix() {
		return mmsFilenameSuffix;
	}

	public void setMmsFilenameSuffix(String mmsFilenameSuffix) {
		this.mmsFilenameSuffix = mmsFilenameSuffix;
	}

	public String getCreateFilenamePrefix() {
		return createFilenamePrefix;
	}

