package com.tcs.aadesh.util;


import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.List;
import java.util.Set;

import org.springframework.stereotype.Component;

import com.tcs.aadesh.config.properties.AppProperties;

@Component
public class FilenameValidator {

    private static final Set<String> ALLOWED_ACTIONS = Set.of("AMEND", "CREATE", "CANCEL");
    private static final DateTimeFormatter DATE_FMT = DateTimeFormatter.ofPattern("ddMMyyyy");

    private final AppProperties appProperties;
    private final List<String> errors = new ArrayList<>();

    public FilenameValidator(AppProperties appProperties) {
        this.appProperties = appProperties;
    }

    public List<String> validate(String fileName) {
        errors.clear();

        if (fileName == null || fileName.trim().isEmpty()) {
            errors.add("FileName: is null or empty");
            return errors;
        }

        String prefix = appProperties.getMmsFilenamePrefix();       // "MMS-"
        String suffix = appProperties.getMmsFilenameSuffix();       // "-INP-ACK.xml"

        // Check prefix
        if (!fileName.startsWith(prefix)) {
            errors.add("FileName: must start with '" + prefix + "'");
            return errors;
        }

        // Check suffix
        if (!fileName.endsWith(suffix)) {
            errors.add("FileName: must end with '" + suffix + "'");
            return errors;
        }

        // Strip prefix and suffix to get the middle part
        String middle = fileName.substring(prefix.length(), fileName.length() - suffix.length());
        String[] parts = middle.split("-");

        // Expected: [AMEND, SBIN, SBINH2HUSER999, 14112026, 000002]
        if (parts.length != 5) {
            errors.add("FileName: expected 5 segments between prefix and suffix, got " + parts.length);
            return errors;
        }

        // Segment 1 (index 0): AMEND / CREATE / CANCEL
        if (!ALLOWED_ACTIONS.contains(parts[0])) {
            errors.add("FileName segment 2: '" + parts[0] + "' not allowed. Must be one of " + ALLOWED_ACTIONS);
        }

        // Segment 2 (index 1): SBIN
        if (!"SBIN".equals(parts[1])) {
            errors.add("FileName segment 3: expected 'SBIN', got '" + parts[1] + "'");
        }

        // Segment 3 (index 2): open for future validation
        // TODO: add validation for 4th segment (user ID)

        // Segment 4 (index 3): date validation (ddMMyyyy)
        validateDate(parts[3]);

        // Segment 5 (index 4): exactly 6 characters
        if (parts[4].length() != 6) {
            errors.add("FileName segment 6: must be exactly 6 characters, got " + parts[4].length() + " ('" + parts[4] + "')");
        }

        return errors;
    }

    public void validateOrThrow(String fileName) {
        List<String> errors = validate(fileName);
        if (!errors.isEmpty()) {
            throw new IllegalArgumentException(
                "FileName validation failed with " + errors.size() + " error(s):\n"
                + String.join("\n", errors)
            );
        }
    }

    // ─── Date validation ─────────────────────────────────────────────────────
    private void validateDate(String dateStr) {
        if (dateStr == null || dateStr.length() != 8) {
            errors.add("FileName date segment: must be 8 characters (ddMMyyyy), got '" + dateStr + "'");
            return;
        }

        LocalDate fileDate;
        try {
            fileDate = LocalDate.parse(dateStr, DATE_FMT);
        } catch (Exception e) {
            errors.add("FileName date segment: '" + dateStr + "' is not a valid date in ddMMyyyy format");
            return;
        }

        int maxAgeDays = appProperties.getMmsMaxAgeDays(); // e.g. 2 or 0

        LocalDate today = LocalDate.now();
        long diff = ChronoUnit.DAYS.between(fileDate, today);

        if (diff > maxAgeDays) {
            errors.add("FileName date segment: date '" + dateStr + "' is " + diff
                       + " days old (max allowed: " + maxAgeDays + ")");
        }
        if (diff < 0) {
            errors.add("FileName date segment: date '" + dateStr + "' is in the future");
        }
    }
}   





