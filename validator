package com.tcs.aadesh.util;

import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.time.format.DateTimeParseException;
import java.time.temporal.ChronoUnit;

import org.springframework.stereotype.Component;

import com.tcs.aadesh.config.properties.NameProperties;

@Component
public class FilenameValidator {

    private static final DateTimeFormatter DATE_FMT = DateTimeFormatter.ofPattern("ddMMyyyy");

    private final NameProperties props;

    public FilenameValidator(NameProperties props) {
        this.props = props;
    }

    public void validate(String fileName) {
        if (fileName == null || fileName.isBlank()) {
            throw new IllegalArgumentException("Filename is null or blank");
        }

        String prefix = props.getMmsFilenamePrefix();
        String suffix = props.getMmsFilenameSuffix();
        int maxAgeDays = props.getMmsMaxAgeDays();

        if (!fileName.startsWith(prefix)) {
            throw new IllegalArgumentException(
                "Filename must start with '" + prefix + "' but was: " + fileName);
        }
        if (!fileName.endsWith(suffix)) {
            throw new IllegalArgumentException(
                "Filename must end with '" + suffix + "' but was: " + fileName);
        }

        String middle = fileName.substring(prefix.length(), fileName.length() - suffix.length());
        String[] parts = middle.split("-");
        if (parts.length != 3) {
            throw new IllegalArgumentException(
                "Expected 3 segments after prefix but got " + parts.length + ": " + middle);
        }

        validateDate(parts[1], maxAgeDays);

        String seqPart = parts[2];
        if (seqPart.length() != 6 || !seqPart.matches("\\d{6}")) {
            throw new IllegalArgumentException(
                "Sequence number must be exactly 6 digits but was: " + seqPart);
        }
    }

    private void validateDate(String datePart, int maxAgeDays) {
        if (datePart.length() != 8) {
            throw new IllegalArgumentException(
                "Date must be 8 characters (ddmmyyyy) but was: " + datePart);
        }
        LocalDate fileDate;
        try {
            fileDate = LocalDate.parse(datePart, DATE_FMT);
        } catch (DateTimeParseException e) {
            throw new IllegalArgumentException(
                "Invalid date format '" + datePart + "' (expected ddmmyyyy)");
        }
        long ageDays = ChronoUnit.DAYS.between(fileDate, LocalDate.now());
        if (ageDays < 0) {
            throw new IllegalArgumentException("Date is in the future: " + datePart);
        }
        if (ageDays > maxAgeDays) {
            throw new IllegalArgumentException(
                "Date is too old (" + ageDays + " days). Max allowed: " + maxAgeDays);
        }
    }
}   




