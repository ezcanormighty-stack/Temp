import jakarta.validation.constraints.NotBlank;

@Component
@Validated
@ConfigurationProperties(prefix = "decryption.directory", ignoreUnknownFields = false)
public class DirectoryProperties {

    @NotBlank(message = "Source path is required")
    private String source;

    @NotBlank(message = "Destination path is required")
    private String destination;

    @NotBlank(message = "Decrypted file path is required")
    private String decrypted;

    @NotBlank(message = "Backup path is required")
    private String backup;

    @NotBlank(message = "Decrypted backup path is required")
    private String outputBackup;

    @NotBlank(message = "Decryption failed path is required")
    private String decryptionFailed;

    @NotBlank(message = "Sign verification failed path is required")
    private String signVerificationFailed;

    @NotBlank(message = "Duplicate file path is required")
    private String duplicateFile;

    @NotBlank(message = "Checking cert path is required")
