import java.time.LocalDateTime;
import java.util.Objects;

public class OutwardDecLogId implements Serializable {

    private static final long serialVersionUID = 1L;

    private String fileName;
    private LocalDateTime lastUpdatedTime;

    public OutwardDecLogId() {}

    public OutwardDecLogId(String fileName, LocalDateTime lastUpdatedTime) {
        this.fileName = fileName;
        this.lastUpdatedTime = lastUpdatedTime;
    }

    public String getFileName() { return fileName; }
    public void setFileName(String fileName) { this.fileName = fileName; }
    public LocalDateTime getLastUpdatedTime() { return lastUpdatedTime; }
    public void setLastUpdatedTime(LocalDateTime lastUpdatedTime) { this.lastUpdatedTime = lastUpdatedTime; }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        OutwardDecLogId that = (OutwardDecLogId) o;
        return Objects.equals(fileName, that.fileName) &&
               Objects.equals(lastUpdatedTime, that.lastUpdatedTime);
    }

    @Override
    public int hashCode() {
        return Objects.hash(fileName, lastUpdatedTime);
    }
}

