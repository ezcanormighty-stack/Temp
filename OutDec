package com.tcs.aadesh.config.properties;

import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import org.springframework.validation.annotation.Validated;

import jakarta.validation.constraints.Min;

@Component
@Validated
@ConfigurationProperties(prefix = "decryption.name", ignoreUnknownFields = false)
public class NameProperties {

    @Min(value = 1, message = "Minimum name length must be configured")
    private int minNameLength;

    @Min(value = 1, message = "Maximum name length must be configured")
    private int maxNameLength;

    @Min(value = 0, message = "Number of allowed history days must be configured")
    private int noOfDays;
    
    private boolean onlyEncrypted;

    public int getMinNameLength() { return minNameLength; }
    public void setMinNameLength(int minNameLength) { this.minNameLength = minNameLength; }
    public int getMaxNameLength() { return maxNameLength; }
    public void setMaxNameLength(int maxNameLength) { this.maxNameLength = maxNameLength; }
    public int getNoOfDays() { return noOfDays; }
    public void setNoOfDays(int noOfDays) { this.noOfDays = noOfDays; }
    public boolean isOnlyEncrypted() { return onlyEncrypted; }
    public void setOnlyEncrypted(boolean onlyEncrypted) { this.onlyEncrypted = onlyEncrypted; }
}

