package com.tcs.aadesh.config.properties;

import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import org.springframework.validation.annotation.Validated;

import jakarta.validation.constraints.NotBlank;

@Component
@Validated
@ConfigurationProperties(prefix = "decryption.directory", ignoreUnknownFields = false)
public class DirectoryProperties {

    @NotBlank(message = "Source path is required")
    private String source;

    @NotBlank(message = "Destination path is required")
    private String destination;

    @NotBlank(message = "Decrypted file path is required")
    private String decrypted;

    @NotBlank(message = "Backup path is required")
    private String backup;

    @NotBlank(message = "Decrypted backup path is required")
    private String outputBackup;

    @NotBlank(message = "Decryption failed path is required")
    private String decryptionFailed;

    @NotBlank(message = "Sign verification failed path is required")
    private String signVerificationFailed;

    @NotBlank(message = "Duplicate file path is required")
    private String duplicateFile;

    @NotBlank(message = "Checking cert path is required")
    private String checkingCert;

    public String getSource() { return source; }
    public void setSource(String source) { this.source = source; }
    public String getDestination() { return destination; }
    public void setDestination(String destination) { this.destination = destination; }
    public String getDecrypted() { return decrypted; }
    public void setDecrypted(String decrypted) { this.decrypted = decrypted; }
    public String getBackup() { return backup; }
    public void setBackup(String backup) { this.backup = backup; }
    public String getOutputBackup() { return outputBackup; }
    public void setOutputBackup(String outputBackup) { this.outputBackup = outputBackup; }
    public String getDecryptionFailed() { return decryptionFailed; }
    public void setDecryptionFailed(String decryptionFailed) { this.decryptionFailed = decryptionFailed; }
    public String getSignVerificationFailed() { return signVerificationFailed; }
    public void setSignVerificationFailed(String signVerificationFailed) { this.signVerificationFailed = signVerificationFailed; }
    public String getDuplicateFile() { return duplicateFile; }
    public void setDuplicateFile(String duplicateFile) { this.duplicateFile = duplicateFile; }
    public String getCheckingCert() { return checkingCert; }
    public void setCheckingCert(String checkingCert) { this.checkingCert = checkingCert; }
}

