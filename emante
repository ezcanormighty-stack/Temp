import com.tcs.aadesh.interceptor.RequestHeaderValidationInterceptor;
import com.tcs.aadesh.interceptor.TransactionInfoInterceptor;

@Configuration
public class WevMvcConfig implements WebMvcConfigurer {

	private final TransactionInfoInterceptor transactionInfoInterceptor;
	private final RequestHeaderValidationInterceptor headerValidationInterceptor;

	public WevMvcConfig(TransactionInfoInterceptor transactionInfoInterceptor,
			RequestHeaderValidationInterceptor headerValidationInterceptor) {
		super();
		this.transactionInfoInterceptor = transactionInfoInterceptor;
		this.headerValidationInterceptor = headerValidationInterceptor;
	}

	@Override
	public void addInterceptors(InterceptorRegistry registry) {
		
		registry.addInterceptor(transactionInfoInterceptor).addPathPatterns("/**");
		
		registry.addInterceptor(headerValidationInterceptor).addPathPatterns("/**");
		
	}
}




