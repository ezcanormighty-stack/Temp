import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;
import org.springframework.http.ResponseEntity;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestClient;

import com.tcs.aadesh.dto.request.EisMicroRequest;
import com.tcs.aadesh.util.AesEncryptionUtility;

import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.json.JsonMapper;

@Service
public class EisMicroRestClient {

	private static final Logger logger = LoggerFactory.getLogger(EisMicroRestClient.class);

	private final RestClient restClient;
	private final AesEncryptionUtility aesEncryptionUtility;
	private final JsonMapper jsonMapper;

	@Autowired
	public EisMicroRestClient(RestClient restClient, AesEncryptionUtility aesEncryptionUtility) {
		this.restClient = restClient;
		this.aesEncryptionUtility = aesEncryptionUtility;
		this.jsonMapper = JsonMapper.builder().build();
	}

	public String callApi(String url, EisMicroRequest requestBean, String key)
			throws InstanceNotFoundException, InvalidKeyException, ClassNotFoundException, NoSuchMethodException,
			InvocationTargetException, InvalidAlgorithmParameterException, NoSuchAlgorithmException,
			NoSuchPaddingException, IllegalBlockSizeException, BadPaddingException, IOException, InterruptedException {

		// 1. Encrypt the session key
		String accessToken = aesEncryptionUtility.rsaEncrypt(key);

		// 2. Create request entity (Serialize using Jackson)
		String jsonPayload = jsonMapper.writeValueAsString(requestBean);

		// 3. Make the call
		ResponseEntity<String> response = restClient
				.post()
				.uri(url)
				.headers(headers -> {
						headers.setContentType(MediaType.APPLICATION_JSON);
						headers.set("AccessToken", accessToken);
					})
				.body(jsonPayload)
				.retrieve()
				.toEntity(String.class);

		Map<String, String> apiResponseMap = jsonMapper.readValue(response.getBody(),
				new TypeReference<Map<String, String>>() {
				});
		
		logger.info("EIS-MICRO REQUEST_REFERENCE_NUMBER: {}", apiResponseMap.get("REQUEST_REFERENCE_NUMBER"));

		String encryptedResponsePayload = apiResponseMap.get("RESPONSE");

		if (encryptedResponsePayload != null) {
			return aesEncryptionUtility.aesDecrypt(encryptedResponsePayload, key);
		} else {
			logger.error("RESPONSE parameter not found in Eis-Microservice response");
			return null;
		}
	}
}



