package com.tcs.aadesh.dto.response;

import java.time.LocalDateTime;

import com.fasterxml.jackson.annotation.JsonPropertyOrder;
import com.tcs.aadesh.constant.ResponseStatus;
import com.tcs.aadesh.dto.ErrorInfo;

//@JsonInclude(JsonInclude.Include.NON_NULL)
@JsonPropertyOrder({ "requestReferenceNo", "status", "sourceId", "timestamp", "data", "error" })
public class ApiResponse<T> {

	private String requestReferenceNo;
	private String sourceId;
	private String status;
	private T data;
	private ErrorInfo error;
	private String timestamp;

	private ApiResponse() {
	}

	private static <T> ApiResponse<T> base(String requestReferenceNo, String sourceId) {
		ApiResponse<T> res = new ApiResponse<>();
		res.requestReferenceNo = requestReferenceNo;
		res.sourceId = sourceId;
		res.timestamp = LocalDateTime.now().toString();
		return res;
	}

	public static <T> ApiResponse<T> success(String requestReferenceNo, String sourceId, T data) {
		ApiResponse<T> res = base(requestReferenceNo, sourceId);
		res.status = ResponseStatus.SUCCESS.getStatus();
		res.data = data;
		return res;
	}

	public static <T> ApiResponse<T> error(String requestReferenceNo, String sourceId, String errorCode,
			String errorDescription) {
		ApiResponse<T> res = base(requestReferenceNo, sourceId);
		res.status = ResponseStatus.FAILURE.getStatus();
		res.error = ErrorInfo.of(errorCode, errorDescription);
		return res;
	}

	public static <T> ApiResponse<T> error(String requestReferenceNo, String sourceId, String errorCode,
			String errorDescription, String errorMessage) {
		ApiResponse<T> res = error(requestReferenceNo, sourceId, errorCode, errorDescription);
		res.error = ErrorInfo.of(errorCode, errorDescription, errorMessage);
		return res;
	}

	public String getRequestReferenceNo() {
		return requestReferenceNo;
	}

	public String getSourceId() {
		return sourceId;
	}

	public String getStatus() {
		return status;
	}

	public T getData() {
		return data;
	}

	public ErrorInfo getError() {
		return error;
	}

	public String getTimestamp() {
		return timestamp;
	}

	@Override
	public String toString() {
		return "ApiResponse [requestReferenceNo=" + requestReferenceNo + ", sourceId=" + sourceId + ", status=" + status
				+ ", data=" + data + ", error=" + error + ", timestamp=" + timestamp + "]";
	}
	
	
}




