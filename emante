		this.acmmMapper = acmmMapper;
		this.acmmRepository = acmmRepository;
		this.mrLnftRepository = mrLnftRepository;
		this.actionRepository = actionRepository;
		this.createMandateValidator = createMandateValidator;
		this.amendMandateValidator = amendMandateValidator;
		this.cancelMandateValidator = cancelMandateValidator;
		this.stopMandateValidator = stopMandateValidator;
		this.revokeMandateValidator = revokeMandateValidator;
		this.idempotencyService = idempotencyService;
	}

	@Transactional
	public ApiResponse<?> createMandate(@Valid CreateMandateRequestDTO request, HttpServletRequest httpRequest) {

		String requestReferenceNo = httpRequest.getHeader("X-Request-Reference-No");
		String sourceId = httpRequest.getHeader("X-Source-Id");

		ApiResponse<String> success = null;

		try {
			// 0. Check Idempotency
			Optional<ApiResponse<?>> cachedResponse = idempotencyService.check(requestReferenceNo, request,
					ApiResponse.class);

			if (cachedResponse.isPresent()) {
				return cachedResponse.get();
			}

			// 1. Business validations
			EisMicroResponse eisMicroResponse = createMandateValidator.validateAndGetEisMicroResponse(request);

			// 2. Insert into ACMM
			if (!acmmRepository.existsByInstNoAndUmrnNo(AppConstants.INST_NO.getValue(), request.getUmrn())) {
				Acmm newAcmm = acmmMapper.toEntity(request, eisMicroResponse);
				acmmRepository.save(newAcmm);
			} else {
				throw new TransactionFailedException("Record already present in ACMM");
			}

			// 3. Insert into MR_LNFT
			insertIntoMrLnft(requestReferenceNo, request.getTxnBranchCode(), request.getAcctNo(), request.getUmrn(),
					request.getTranType(), request.getTellerId());

			success = ApiResponse.success(requestReferenceNo, sourceId, "Mandate created successfully");

			idempotencyService.markSuccess(requestReferenceNo, success);

		} catch (TransactionFailedException | DataAccessException e) {
			ErrorLogger.log(log, e);
			throw new TransactionFailedException("Database transaction failed");
		}

		return success;
	}

	@Transactional
	public ApiResponse<?> amendMandate(@Valid AmendMandateRequestDTO request, HttpServletRequest httpRequest) {

		String requestReferenceNo = httpRequest.getHeader("X-Request-Reference-No");
		String sourceId = httpRequest.getHeader("X-Source-Id");

		ApiResponse<String> success = null;

		// 0. Check Idempotency
		Optional<ApiResponse<?>> cachedResponse = idempotencyService.check(requestReferenceNo, request,
				ApiResponse.class);

		if (cachedResponse.isPresent()) {
			return cachedResponse.get();
		}

		// 1. Business validations
		Acmm acmm = amendMandateValidator.validateAmendRequest(request);

		// 2. Copy ACMM to ACMH
		try {
			int rowsCopied = actionRepository.copyAcmmToAcmh(acmm.getInstNo(), acmm.getUmrnNo());

			if (rowsCopied == 0) {
				log.warn("Failed to copy ACMM into ACMH: No rows affected for UmrnNo: {}", acmm.getUmrnNo());
				throw new TransactionFailedException("Failed to copy ACMM row into ACMH");
			}

			log.info("Copied ACMM into ACMH successfully: {} rows processed", rowsCopied);

			// 3. Update ACMM
			Acmm updatedAcmm = acmmMapper.toEntity(request, acmm);

