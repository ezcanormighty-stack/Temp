			"/inward/e-mandate/test/",
			"/inward/e-mandate/v2/api-docs",
			"/inward/e-mandate/swagger-ui.html"
			);

	private final AuditService auditService;

	public AuditFilter(AuditService auditService) {
		this.auditService = auditService;
	}

	@Override
	protected boolean shouldNotFilter(HttpServletRequest request) {
		String uri = request.getRequestURI();
		return EXCLUDED_URIS.stream().anyMatch(uri::startsWith);
	}

	@Override
	protected void doFilterInternal(
			@Nonnull HttpServletRequest request, 
			@Nonnull HttpServletResponse response,
			@Nonnull FilterChain filterChain) throws ServletException, IOException {

		CachedBodyHttpServletRequest requestWrapper = new CachedBodyHttpServletRequest(request);
		ContentCachingResponseWrapper responseWrapper = new ContentCachingResponseWrapper(response);

		try {
			filterChain.doFilter(requestWrapper, responseWrapper);
		} finally {
			try {
				auditService.saveAuditLog(requestWrapper, responseWrapper);
			} catch (Exception e) {
				log.error("Audit log failed | Audit record already exist");
			} finally {
				ErrorContextHolder.clear(); //Mandatory
				responseWrapper.copyBodyToResponse(); //Writes the cached response body to the actual output stream
			}
		}
	}
}


package com.tcs.aadesh.interceptor;

import org.springframework.stereotype.Component;
import org.springframework.web.servlet.HandlerInterceptor;

import com.tcs.aadesh.constant.RequestConstants;
import com.tcs.aadesh.exception.BusinessException;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Component
public class RequestHeaderValidationInterceptor implements HandlerInterceptor {

	@Override
	public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) {

		String requestReferenceNo = request.getHeader(RequestConstants.Headers.REQ_REF_NO);
		String sourceId = request.getHeader(RequestConstants.Headers.SOURCE_ID);

		// Request-Reference-No Validation
		if (requestReferenceNo == null || !requestReferenceNo.matches("^SBI[A-Za-z0-9]{22}$")) {
			throw new BusinessException("ER015");
		}

		// Source-Id Validation
		if (sourceId == null || !sourceId.matches("[a-zA-Z ]+")) {
			throw new BusinessException("AD003", "Missing or invalid Source Id");
		}

		if (sourceId.length() > 5) {
			throw new BusinessException("AD009", "Source Id must not exceed 5 characters");
		}

		return true;
	}

}




package com.tcs.aadesh.interceptor;

import org.springframework.stereotype.Component;
import org.springframework.web.method.HandlerMethod;
import org.springframework.web.servlet.HandlerInterceptor;

import com.tcs.aadesh.annotation.TxnInfo;

import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;

@Component
public class TransactionInfoInterceptor implements HandlerInterceptor {

	public static final String TXN_NO_HEADER = "X-Internal-Txn-No";
	public static final String TXN_NAME_HEADER = "X-Internal-Txn-Name";

	@Override
	public boolean preHandle(
			HttpServletRequest request, 
			HttpServletResponse response, 
			Object handler) {

		if (handler instanceof HandlerMethod handlerMethod) {
			TxnInfo txnInfo = handlerMethod.getMethodAnnotation(TxnInfo.class);

			if (txnInfo != null) {
				response.setHeader(TXN_NO_HEADER, txnInfo.txnNo());
				response.setHeader(TXN_NAME_HEADER, txnInfo.txnName());
			}
		}

		return true;
	}
}


