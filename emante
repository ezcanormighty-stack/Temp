import com.tcs.aadesh.util.AesEncryptionUtility;
import com.tcs.aadesh.util.ErrorLogger;

import tools.jackson.databind.json.JsonMapper;

@Service
public class EisMicroEncryptionService {
	private static Logger log = LoggerFactory.getLogger(EisMicroEncryptionService.class);

	private final AesEncryptionUtility encryptionUtility;

	private final JsonMapper jsonMapper;

	@Autowired
	public EisMicroEncryptionService(AesEncryptionUtility encryptionUtility) {
		super();
		this.encryptionUtility = encryptionUtility;
		this.jsonMapper = JsonMapper.builder().build();

	}

	public EncryptedEisMicroPayload createEncryptedRequest(String acctNo) {
		Map<String, Object> queryParams = new HashMap<>();
		String refNo = generateReqRefNumber();

		EncryptedEisMicroPayload eisMicroPayload = new EncryptedEisMicroPayload();

		try {
			String aesKey = generateSecureRandomKey(32);

			queryParams.put("SOURCE_ID", "HA");
			queryParams.put("ACCOUNT_NUMBER", acctNo);

			// Convert Map to JSON String using Jackson
			String jsonParams = jsonMapper.writeValueAsString(queryParams);

			EisMicroRequest eisMicroRequest = new EisMicroRequest();
			eisMicroRequest.setREQUEST_REFERENCE_NUMBER(refNo);
			eisMicroRequest.setREQUEST(encryptionUtility.eisEncrypt(jsonParams, aesKey));
			eisMicroRequest.setDIGI_SIGN(encryptionUtility.sign(jsonParams).replaceAll("\r\n|\n", ""));

			eisMicroPayload.setEisMicroRequest(eisMicroRequest);
			eisMicroPayload.setAesKey(aesKey);
			
			
			System.out.println("eisMicroRequest: "+ eisMicroRequest);


		} catch (IOException | InstanceNotFoundException | InvalidKeyException | ClassNotFoundException
				| NoSuchMethodException | InvocationTargetException | InvalidAlgorithmParameterException
				| NoSuchAlgorithmException | SignatureException | InterruptedException | NoSuchPaddingException
				| IllegalBlockSizeException | BadPaddingException e) {

			ErrorLogger.log(log, "Error occured during generating request", e);
			throw new UnexpectedException();
		}
		

		return eisMicroPayload;
	}

	public String generateSecureRandomKey(int length) {
		String chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
		SecureRandom secureRandom = new SecureRandom();
		byte[] randomBytes = new byte[length];
		secureRandom.nextBytes(randomBytes);

		StringBuilder sb = new StringBuilder();
		for (byte b : randomBytes) {
			sb.append(chars.charAt(((int) b & 0xff) % chars.length()));
		}
		return sb.toString();
	}

	public String generateReqRefNumber() {
		String sourceId = "HA";
		Calendar calendar = Calendar.getInstance();
		int dayOfTheYear = calendar.get(Calendar.DAY_OF_YEAR);
		String zeroPaddedDayOfTheYear = String.format("%03d", dayOfTheYear);
		Date date = new Date();
		SimpleDateFormat SimpleDateFormat = new SimpleDateFormat("yy-hh-mm-ss-SSS");
		String parse = SimpleDateFormat.format(date);
		int i = new SecureRandom().nextInt(900000) + 100000;
		String[] split = parse.split("-");
		return ("SBI" + sourceId + split[0] + zeroPaddedDayOfTheYear + split[1] + split[2] + split[3] + split[4] + i)
				.toString();
	}

}


