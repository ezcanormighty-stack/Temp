package com.tcs.aadesh.exception.handler;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.dao.DataAccessException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.http.converter.HttpMessageNotReadableException;
import org.springframework.validation.FieldError;
import org.springframework.web.HttpRequestMethodNotSupportedException;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.MissingRequestHeaderException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import com.tcs.aadesh.cache.ErrorCodeCacheService;
import com.tcs.aadesh.config.properties.FieldErrorCodeProperties;
import com.tcs.aadesh.constant.AppConstants;
import com.tcs.aadesh.context.ErrorContext;
import com.tcs.aadesh.context.ErrorContextHolder;
import com.tcs.aadesh.dto.response.ApiResponse;
import com.tcs.aadesh.exception.BusinessException;
import com.tcs.aadesh.exception.EisMicroException;
import com.tcs.aadesh.exception.InvalidRequestHeaderException;
import com.tcs.aadesh.exception.TransactionFailedException;
import com.tcs.aadesh.exception.UnexpectedException;
import com.tcs.aadesh.util.ErrorLogger;

import jakarta.servlet.http.HttpServletRequest;

@RestControllerAdvice
public class GlobalExceptionHandler {

	private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);

	private static final String TECHNICAL_ERROR = AppConstants.TECHNICAL_ERROR.getValue();

	private final FieldErrorCodeProperties fieldProperties;
	private final ErrorCodeCacheService errorCodeCache;

	public GlobalExceptionHandler(FieldErrorCodeProperties fieldProperties, ErrorCodeCacheService errorCodeCache) {
		this.fieldProperties = fieldProperties;
		this.errorCodeCache = errorCodeCache;
	}

	private ResponseEntity<ApiResponse<Void>> buildErrorResponse(HttpServletRequest request, Exception ex,
			HttpStatus status, String errorCode, String errorDescription, String errorMessage) {

		ErrorLogger.log(log, ex);

		ErrorContextHolder.set(ErrorContext.of(errorCode, errorDescription));
		
		String refNo = request.getHeader("X-Request-Reference-No");
		String sourceId = request.getHeader("X-Source-Id");

		return ResponseEntity.status(status)
				.body(errorMessage != null
						? ApiResponse.error(refNo, sourceId, errorCode, errorDescription, errorMessage)
						: ApiResponse.error(refNo, sourceId, errorCode, errorDescription));
	}

	// For handlers that have errorMessage = null
	private ResponseEntity<ApiResponse<Void>> buildErrorResponse(HttpServletRequest request, Exception ex,
			HttpStatus status, String errorCode, String errorDescription) {

		return buildErrorResponse(request, ex, status, errorCode, errorDescription, null);
	}

	// ----- EXCEPTION HANDLERS ------------------------------------------------

	@ExceptionHandler(InvalidRequestHeaderException.class)
	public ResponseEntity<ApiResponse<Void>> handleValidationAnnotation(InvalidRequestHeaderException ex,
			HttpServletRequest request) {
		ErrorLogger.log(log, ex);
		return buildErrorResponse(request, ex, HttpStatus.BAD_REQUEST, "ER015", errorCodeCache.getDescription("ER015"),
				ex.getErrorMessage());
	}

	@ExceptionHandler(MethodArgumentNotValidException.class)
	public ResponseEntity<ApiResponse<Void>> handleValidationAnnotation(MethodArgumentNotValidException ex,
			HttpServletRequest request) {
		ErrorLogger.log(log, ex);

		FieldError fieldError = ex.getBindingResult().getFieldErrors().stream().findFirst().orElse(null);

		if (fieldError != null) {
			String field = fieldError.getField();

			String errorCode;
			if ("Size".equals(fieldError.getCode())) {
				errorCode = "AD009";
			} else {
				errorCode = fieldProperties.getCode(field);
			}

			return buildErrorResponse(request, ex, HttpStatus.BAD_REQUEST, errorCode,
					errorCodeCache.getDescription(errorCode), fieldError.getDefaultMessage());
		}

		var globalError = ex.getBindingResult().getGlobalErrors().stream().findFirst().orElse(null);

		return buildErrorResponse(request, ex, HttpStatus.BAD_REQUEST, "AD003", // Invalid request field
				errorCodeCache.getDescription("AD003"), globalError != null ? globalError.getDefaultMessage() : null);
	}

	@ExceptionHandler(MissingRequestHeaderException.class)
	public ResponseEntity<ApiResponse<Void>> handleMissingHeader(MissingRequestHeaderException ex,
			HttpServletRequest request) {
		String field = ex.getHeaderName();
		String errorCode = fieldProperties.getCode(field);

		return buildErrorResponse(request, ex, HttpStatus.BAD_REQUEST, errorCode,
				errorCodeCache.getDescription(errorCode));
	}

	@ExceptionHandler(BusinessException.class)
	public ResponseEntity<ApiResponse<Void>> handleBusiness(BusinessException ex, HttpServletRequest request) {
		
		ErrorLogger.log(log, ex.getErrorMessage(), ex);

		return buildErrorResponse(
				request, 
				ex, 
				HttpStatus.BAD_REQUEST, 
				ex.getErrorCode(),
				errorCodeCache.getDescription(ex.getErrorCode()),
				ex.getErrorMessage()
				);
	}
	
	@ExceptionHandler(UnexpectedException.class)
	public ResponseEntity<ApiResponse<Void>> handleUnexpected(UnexpectedException ex, HttpServletRequest request) {
		ErrorLogger.log(log, ex.getErrorMessage(), ex);

		return buildErrorResponse(
				request, 
				ex, 
				HttpStatus.INTERNAL_SERVER_ERROR,
				ex.getErrorCode(),
				errorCodeCache.getDescription(ex.getErrorCode()));
	}

	@ExceptionHandler(EisMicroException.class)
	public ResponseEntity<ApiResponse<Void>> handleEisMicro(EisMicroException ex, HttpServletRequest request) {
		String errCode = ex.getErrorCode();
		String errDesc;

		if (errCode.equalsIgnoreCase("0188")) {
			errDesc = "ACCOUNT NOT FOUND IN CBS";
		} else {
			errDesc = errorCodeCache.getDescription(errCode);
		}
		return buildErrorResponse(request, ex, HttpStatus.INTERNAL_SERVER_ERROR, errCode, errDesc,
				ex.getErrorMessage());
	}

	@ExceptionHandler(TransactionFailedException.class)
	public ResponseEntity<ApiResponse<Void>> handleTransactionFailedException(TransactionFailedException ex,
			HttpServletRequest request) {
		return buildErrorResponse(request, ex, HttpStatus.INTERNAL_SERVER_ERROR, ex.getErrorCode(),
				errorCodeCache.getDescription(ex.getErrorCode()), "A system error occurred. Please try again later.");
	}

	@ExceptionHandler(HttpMessageNotReadableException.class)
	public ResponseEntity<ApiResponse<Void>> handleUnreadable(HttpMessageNotReadableException ex,
			HttpServletRequest request) {
		return buildErrorResponse(request, ex, HttpStatus.BAD_REQUEST, TECHNICAL_ERROR,
				errorCodeCache.getDescription(TECHNICAL_ERROR));
	}

	@ExceptionHandler(HttpRequestMethodNotSupportedException.class)
	public ResponseEntity<ApiResponse<Void>> handleMethodNotSupported(HttpRequestMethodNotSupportedException ex,
			HttpServletRequest request) {
		return buildErrorResponse(request, ex, HttpStatus.METHOD_NOT_ALLOWED, TECHNICAL_ERROR,
				errorCodeCache.getDescription(TECHNICAL_ERROR));
	}

	@ExceptionHandler(DataAccessException.class)
	public ResponseEntity<ApiResponse<Void>> handleDataAccess(DataAccessException ex, HttpServletRequest request) {
		return buildErrorResponse(request, ex, HttpStatus.INTERNAL_SERVER_ERROR, TECHNICAL_ERROR,
				errorCodeCache.getDescription(TECHNICAL_ERROR), "A system error occurred. Please try again later.");
	}

	@ExceptionHandler(Exception.class)
	public ResponseEntity<ApiResponse<Void>> handleGeneric(Exception ex, HttpServletRequest request) {
		return buildErrorResponse(request, ex, HttpStatus.INTERNAL_SERVER_ERROR, TECHNICAL_ERROR,
				errorCodeCache.getDescription(TECHNICAL_ERROR), "A system error occurred. Please try again later.");
	}
}





