package com.tcs.aadesh.util;

import java.io.FileInputStream;
import java.io.IOException;
import java.lang.reflect.InvocationTargetException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Paths;
import java.security.InvalidAlgorithmParameterException;
import java.security.InvalidKeyException;
import java.security.KeyFactory;
import java.security.NoSuchAlgorithmException;
import java.security.PrivateKey;
import java.security.PublicKey;
import java.security.Security;
import java.security.Signature;
import java.security.SignatureException;
import java.security.cert.CertificateException;
import java.security.cert.CertificateFactory;
import java.security.cert.X509Certificate;
import java.security.spec.InvalidKeySpecException;
import java.security.spec.PKCS8EncodedKeySpec;
import java.util.Arrays;
import java.util.Base64;

import javax.crypto.BadPaddingException;
import javax.crypto.Cipher;
import javax.crypto.IllegalBlockSizeException;
import javax.crypto.NoSuchPaddingException;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.SecretKeySpec;
import javax.management.InstanceNotFoundException;

import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Component;

import jakarta.annotation.PostConstruct;

@Component
public class AesEncryptionUtility {
	private static final org.slf4j.Logger LOGGER = LoggerFactory.getLogger(AesEncryptionUtility.class);
	private static final String AES_TRANSFORMATION = "AES/GCM/NoPadding";
	private static final String RSA_TRANSFORMATION = "RSA/ECB/OAEPPadding";
	private static final String SIGNATURE_ALGORITHM = "SHA256withRSA";

	private final String privateKeyPath;
	private final String certPath;

	private PrivateKey eisPrivateKey;
	private PublicKey eisPublicKey;

	public AesEncryptionUtility(@Value("${micro.privatekey.path}") String privateKeyPath,
			@Value("${micro.publickey.path}") String certPath) {
		this.privateKeyPath = privateKeyPath;
		this.certPath = certPath;
	}

	@PostConstruct
	public void init() throws IOException, ClassNotFoundException, NoSuchMethodException, InvocationTargetException,
			InstanceNotFoundException, InvalidAlgorithmParameterException, InterruptedException,
			NoSuchAlgorithmException, InvalidKeySpecException, CertificateException {
		LOGGER.info("Initializing AESEncryptionUtility...");
		Security.addProvider(new org.bouncycastle.jce.provider.BouncyCastleProvider());

		// Load private key once
		byte[] keyBytes = Files.readAllBytes(Paths.get(privateKeyPath));
		String privateKeyPEM = new String(keyBytes, StandardCharsets.UTF_8).replaceAll("\\n", "")
				.replace("-----BEGIN RSA PRIVATE KEY-----", "").replace("-----END RSA PRIVATE KEY-----", "");
		byte[] decodedKey = Base64.getDecoder().decode(privateKeyPEM);
		KeyFactory kf = KeyFactory.getInstance("RSA");
		this.eisPrivateKey = kf.generatePrivate(new PKCS8EncodedKeySpec(decodedKey));

		// Load public key from certificate once
		try (FileInputStream fin = new FileInputStream(certPath)) {
			CertificateFactory f = CertificateFactory.getInstance("X.509");
			X509Certificate certificate = (X509Certificate) f.generateCertificate(fin);
			this.eisPublicKey = certificate.getPublicKey();
		}
		LOGGER.info("AESEncryptionUtility initialized successfully.");
	}

	// This method is now instance-level, not static
	public String eisEncrypt(String message, String key) throws IOException, ClassNotFoundException,
			NoSuchMethodException, InvocationTargetException, InstanceNotFoundException,
			InvalidAlgorithmParameterException, InterruptedException, NoSuchAlgorithmException, NoSuchPaddingException,
			InvalidKeyException, IllegalBlockSizeException, BadPaddingException {
		
		byte[] keybyte = key.getBytes(StandardCharsets.UTF_8);
		byte[] ivkey = Arrays.copyOf(keybyte, 12);

		SecretKeySpec seckey = new SecretKeySpec(keybyte, "AES");
		Cipher c = Cipher.getInstance(AES_TRANSFORMATION);
		GCMParameterSpec gcmParameterSpec = new GCMParameterSpec(128, ivkey);
		c.init(Cipher.ENCRYPT_MODE, seckey, gcmParameterSpec);

		byte[] encvalue = c.doFinal(message.getBytes(StandardCharsets.UTF_8));
		return Base64.getEncoder().encodeToString(encvalue);
	}

	// This method is now instance-level, not static
	public String sign(String message) throws IOException, ClassNotFoundException, NoSuchMethodException,
			InvocationTargetException, InstanceNotFoundException, InvalidAlgorithmParameterException,
			InterruptedException, NoSuchAlgorithmException, InvalidKeyException, SignatureException {
		Signature sign = Signature.getInstance(SIGNATURE_ALGORITHM);
		sign.initSign(this.eisPrivateKey);
		sign.update(message.getBytes(StandardCharsets.UTF_8));
		return Base64.getEncoder().encodeToString(sign.sign());
	}

	// This method is now instance-level, not static
	public String rsaEncrypt(String data) throws IOException, ClassNotFoundException, NoSuchMethodException,
			InvocationTargetException, InstanceNotFoundException, InvalidAlgorithmParameterException,
			InterruptedException, NoSuchAlgorithmException, NoSuchPaddingException, InvalidKeyException,
			IllegalBlockSizeException, BadPaddingException {
		Cipher cipher = Cipher.getInstance(RSA_TRANSFORMATION);
		cipher.init(Cipher.ENCRYPT_MODE, this.eisPublicKey);
		byte[] encdatabyte = cipher.doFinal(data.getBytes(StandardCharsets.UTF_8));
		return Base64.getEncoder().encodeToString(encdatabyte);
	}

	public String aesDecrypt(String message, String key) throws IOException, ClassNotFoundException,
			NoSuchMethodException, InvocationTargetException, InstanceNotFoundException,
			InvalidAlgorithmParameterException, InterruptedException, NoSuchAlgorithmException, NoSuchPaddingException,
			InvalidKeyException, IllegalBlockSizeException, BadPaddingException {
		byte[] keybyte = key.getBytes(StandardCharsets.UTF_8);
		byte[] ivkey = Arrays.copyOf(keybyte, 12);

		byte[] encvalue = Base64.getDecoder().decode(message);
		SecretKeySpec seckey = new SecretKeySpec(keybyte, "AES");
		Cipher c = Cipher.getInstance(AES_TRANSFORMATION);
		GCMParameterSpec gcmParameterSpec = new GCMParameterSpec(128, ivkey);

		c.init(Cipher.DECRYPT_MODE, seckey, gcmParameterSpec);
		byte[] decvalue = c.doFinal(encvalue);
		return new String(decvalue, StandardCharsets.UTF_8);
	}
}



package com.tcs.aadesh.util;

public class CalculateCheckDigit {

	public static char calculateCheckDigit(String accountNumber) {
		int len = accountNumber.length();
		int count = 16 - len;
		String outAcctNumber = formPadStr('0', count).concat(accountNumber);

		int counter1 = 5;
		int finalVal = 0;
		for (int idx = 0; idx < 16; ++idx) {
			int byteVal = Character.getNumericValue(outAcctNumber.charAt(idx));

			finalVal = (int) (finalVal + Math.pow(2.0D, counter1) * byteVal % 11.0D);

			if (counter1 == 0)
				counter1 = 10;
			--counter1;
		}

		int chkDigit = finalVal % 10;
		return Character.forDigit(chkDigit, 10);
	}

	public static char calculateCheckDigitCif(String primAcct) {
		int len = primAcct.length();
		int count = 11 - len;
		String outAcctNumber = formPadStr('0', count).concat(primAcct);

		int counter1 = 5;
		int finalVal = 0;
		for (int idx = 0; idx < 11; ++idx) {
			int byteVal = Character.getNumericValue(outAcctNumber.charAt(idx));

			finalVal = (int) (finalVal + Math.pow(2.0D, counter1) * byteVal % 11.0D);

			if (counter1 == 0)
				counter1 = 10;
			--counter1;
		}

		int chkDigit = finalVal % 10;
		return Character.forDigit(chkDigit, 10);
	}

	public static String AccountNumberWithCheckDigit(String accountNumber) {
		int len = accountNumber.length();
		int count = 16 - len;
		String outAcctNumber = formPadStr('0', count).concat(accountNumber);

		int counter1 = 5;
		int finalVal = 0;
		for (int idx = 0; idx < 16; ++idx) {
			int byteVal = Character.getNumericValue(outAcctNumber.charAt(idx));

			finalVal = (int) (finalVal + Math.pow(2.0D, counter1) * byteVal % 11.0D);

			if (counter1 == 0)
				counter1 = 10;
			--counter1;
		}

		int chkDigit = finalVal % 10;
		String AcctwithChkdgt = outAcctNumber + String.valueOf(chkDigit);
		return AcctwithChkdgt;
	}

	public static boolean validateCheckDigit(String accountNumber) {
		String acctNumWOChkDgt = accountNumber.substring(0, accountNumber.length() - 1);
		char chkDgtSupplied = accountNumber.charAt(accountNumber.length() - 1);

		return calculateCheckDigit(acctNumWOChkDgt) == chkDgtSupplied;
	}

	public String AccountNumberWithoutCheckDigit(String accountNumber) throws Exception {
		String acctNumWOChkDgt = accountNumber.substring(0, accountNumber.length() - 1);
		char chkDgtSupplied = accountNumber.charAt(accountNumber.length() - 1);

		if (calculateCheckDigit(acctNumWOChkDgt) == chkDgtSupplied) {
			return acctNumWOChkDgt;
		}

		String errorMessage = "Invalid Check Digit";

		throw new Exception(errorMessage);
	}

	public static String formPadStr(char character, int count) {
		if (count <= 0)
			return "";
		char[] buffer = new char[count];
		for (int idx = 0; idx < count; ++idx) {
			buffer[idx] = character;
		}
		return String.valueOf(buffer);
	}
}


package com.tcs.aadesh.util;

import org.slf4j.Logger;
import org.springframework.stereotype.Component;

@Component
public final class ErrorLogger {

	static String currentPackage = ErrorLogger.class.getPackage().getName();

	static int lastDotIndex = currentPackage.lastIndexOf('.');

	private static final String APP_BASE_PACKAGE = currentPackage.substring(0, lastDotIndex);

	private ErrorLogger() {
	}

	public static void log(Logger log, Exception e) {
		if (e == null) {
			log.error("{} | Unknown error (exception was null)");
			return;
		}

		StackTraceElement origin = findApplicationTrace(e);

		log.error("{} in {}.{}({}:{}) | {}", e.getClass().getSimpleName(), origin.getClassName(),
				origin.getMethodName(), origin.getFileName(), origin.getLineNumber(), safeMessage(e));
	}

	public static void log(Logger log, String message, Exception e) {
		if (e == null) {
			log.error("{} | Unknown error (exception was null)", message);
			return;
		}

		StackTraceElement origin = findApplicationTrace(e);

		log.error("{} | {} in {}.{}({}:{}) | {}", message, e.getClass().getSimpleName(), origin.getClassName(),
				origin.getMethodName(), origin.getFileName(), origin.getLineNumber(), safeMessage(e));
	}

	private static StackTraceElement findApplicationTrace(Exception e) {
		for (StackTraceElement element : e.getStackTrace()) {
			if (element.getClassName().startsWith(APP_BASE_PACKAGE)) {
				return element;
			}
		}
		// fallback if no application class found
		return e.getStackTrace().length > 0 ? e.getStackTrace()[0]
				: new StackTraceElement("UnknownClass", "UnknownMethod", "UnknownFile", -1);
	}

	private static String safeMessage(Exception e) {
		return (e.getMessage() == null || e.getMessage().isBlank()) ? "(no message)" : e.getMessage();
	}
}


package com.tcs.aadesh.util;

import java.math.BigDecimal;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

public class Utility {
	private static Logger log = LoggerFactory.getLogger(Utility.class);

	public static BigDecimal toBigDecimal(String value) {
		if (value == null || value.trim().isEmpty()) {
			return null;
		}
		try {
			return new BigDecimal(value.trim());
		} catch (NumberFormatException e) {
			ErrorLogger.log(log, e);
			throw new IllegalArgumentException("Invalid numeric format: " + value);
		}
	}

	public static String removeLeadingZeros(String str) {
		if (str == null) {
			return null;
		}

		str = str.replaceAll("\\D", ""); // removes all non-digit characters

		int index = 0;
		while (index < str.length() && str.charAt(index) == '0') {
			index++;
		}

		return index == str.length() ? "0" : str.substring(index);
	}

	public static String sanitize(String inputStr) {
		if (inputStr == null) {
			return null;
		}

		String digitsOnly = null;
		StringBuilder sb;

		try {
			digitsOnly = removeLeadingZeros(inputStr.trim()); // returns "0" if inputStr contains all 0

			if (digitsOnly.isEmpty() || digitsOnly.equals("0")) {
				return null;
			}

			if (digitsOnly.length() >= 17) {
				digitsOnly = digitsOnly.substring(0, 11);
			}

			int padLength = 17 - digitsOnly.length();
			sb = new StringBuilder(17);
			for (int i = 0; i < padLength; i++) {
				sb.append('0');
			}
		} catch (StringIndexOutOfBoundsException | IllegalArgumentException e) {
			throw new IllegalStateException("Sanitization error");
		}
		sb.append(digitsOnly);
		return sb.toString();
	}
}


