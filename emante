package com.tcs.aadesh.cache;

import java.util.HashMap;
import java.util.Map;

//import javax.annotation.PostConstruct;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.tcs.aadesh.entity.ErrorCode;
import com.tcs.aadesh.repository.ErrorCodeRepository;

import jakarta.annotation.PostConstruct;

@Service
public class ErrorCodeCacheService {
	private static Logger logger = LoggerFactory.getLogger(ErrorCodeCacheService.class);

	private final ErrorCodeRepository errorCodeRepository;
	private final Map<String, String> map = new HashMap<>();

	@Autowired
	public ErrorCodeCacheService(ErrorCodeRepository errorCodeRepository) {
		super();
		this.errorCodeRepository = errorCodeRepository;
	}

	@PostConstruct
	public void load() {
		for (ErrorCode e : errorCodeRepository.findAll()) {
			map.put(e.getErrorId(), e.getErrorDescription());
		}
		logger.info("ErrorCodeCache loaded successfully.");

	}

	public String getDescription(String code) {
		return map.getOrDefault(code, "Unknown error");
	}

}




package com.tcs.aadesh.cache;

import java.util.HashSet;
import java.util.Set;
import java.util.stream.Collectors;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import com.tcs.aadesh.entity.Product1Card;
import com.tcs.aadesh.entity.SponsorAllowCard;
import com.tcs.aadesh.repository.Amount1CardRepo;
import com.tcs.aadesh.repository.BounceCountCardRepo;
import com.tcs.aadesh.repository.Product1CardRepo;
import com.tcs.aadesh.repository.SponserAllowCardRepo;
import com.tcs.aadesh.repository.TredsLimitCardRepo;

import jakarta.annotation.PostConstruct;

@Service
public class ValidationCacheService {
	private static Logger logger = LoggerFactory.getLogger(ValidationCacheService.class);

	private final BounceCountCardRepo bounceCountCardRepo;
	private final Amount1CardRepo amount1CardRepo;
	private final Product1CardRepo product1CardRepo;
	private final SponserAllowCardRepo sponserAllowCardRepo;
	private final TredsLimitCardRepo tredsLimitCardRepo;

	private volatile String dishonourCounter;
	private volatile String amount1CardAmount;
	private volatile String tredsLimitStr;
	private volatile Set<String> product1CardValues;
	private volatile Set<SponsorAllowCard> sponsorAllowCards;

	@Autowired
	public ValidationCacheService(BounceCountCardRepo bounceCountCardRepo, Amount1CardRepo amount1CardRepo,
			Product1CardRepo product1CardRepo, SponserAllowCardRepo sponserAllowCardRepo,
			TredsLimitCardRepo tredsLimitCardRepo) {
		super();
		this.bounceCountCardRepo = bounceCountCardRepo;
		this.amount1CardRepo = amount1CardRepo;
		this.product1CardRepo = product1CardRepo;
		this.sponserAllowCardRepo = sponserAllowCardRepo;
		this.tredsLimitCardRepo = tredsLimitCardRepo;
	}

	@PostConstruct
	public void loadValidationCache() {
		refreshCache();
	}

	@Scheduled(cron = "0 30 2 * * *")
	private void refreshCache() {

		dishonourCounter = bounceCountCardRepo.findDishonourCounter();

		amount1CardAmount = amount1CardRepo.findMandateAmount();

		tredsLimitStr = tredsLimitCardRepo.findTredsLimit();

		product1CardValues = product1CardRepo.findAll().stream().map(Product1Card::getAcctTypeIntCat)
				.collect(Collectors.toCollection(HashSet::new));

		sponsorAllowCards = new HashSet<>(sponserAllowCardRepo.findAll());

		logger.info("DishonourCounter, AcctTypeIntCats, TredsLimit & SponsorAllowCards cache refreshed successfully.");
	}

	public String getDishonourCounter() {
		return dishonourCounter;
	}

	public String getAmount1CardAmount() {
		return amount1CardAmount;
	}

	public String getTredsLimitStr() {
		return tredsLimitStr;
	}

	public Set<String> getProduct1CardValues() {
		return product1CardValues;
	}

	public Set<SponsorAllowCard> getSponsorAllowCards() {
		return sponsorAllowCards;
	}
}



