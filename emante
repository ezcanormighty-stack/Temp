package com.tcs.aadesh.service;

import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.security.NoSuchAlgorithmException;
import java.time.LocalDateTime;
import java.util.Base64;
import java.util.Optional;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import com.tcs.aadesh.dto.response.ApiResponse;
import com.tcs.aadesh.entity.IdempotencyRecord;
import com.tcs.aadesh.exception.BusinessException;
import com.tcs.aadesh.exception.UnexpectedException;
import com.tcs.aadesh.repository.IdempotencyRepository;
import com.tcs.aadesh.util.ErrorLogger;

import tools.jackson.databind.ObjectMapper;
import tools.jackson.databind.exc.JsonNodeException;

@Service
public class IdempotencyService {

	private static final Logger log = LoggerFactory.getLogger(IdempotencyService.class);

	private final int ttlHours;
	private final ObjectMapper objectMapper;
	private final IdempotencyRepository idempotencyRepository;

	@Autowired
	public IdempotencyService(
			@Value("${idempotency.ttl.hours}") int ttlHours,
			IdempotencyRepository idempotencyRepository, 
			ObjectMapper objectMapper
			) {
		super();
		this.ttlHours = ttlHours;
		this.objectMapper = objectMapper;
		this.idempotencyRepository = idempotencyRepository;
	}

	@Transactional
	public <T> Optional<ApiResponse<?>> check(String requestReferenceNo, Object requestBody, Class<T> responseType) {

		String currentHash = hash(requestBody);

		Optional<IdempotencyRecord> existing = idempotencyRepository.findByRequestReferenceNo(requestReferenceNo)
				.filter(r -> !r.isExpired());

		if (existing.isPresent()) {
			IdempotencyRecord record = existing.get();

			if (!currentHash.equals(record.getRequestHash())) {
				log.warn("Request ref number already used with different request body");
				throw new BusinessException("AD004");
			}

			if (record.isSuccess()) {
				// return cached response
				log.info("Idempotent hit — returning cached response");
				try {
					ApiResponse<?> cachedResponse = (ApiResponse<?>) objectMapper.readValue(record.getResponseBody(),
							responseType);
					return Optional.of(cachedResponse);
				} catch (JsonNodeException e) {
					ErrorLogger.log(log, "Failed to deserialize cached response", e);
					throw new UnexpectedException();
				}
			}

			if (record.isProcessing()) {
				log.warn("Request with this reference number is already being processed");
				throw new BusinessException("AD004");
			}
		}

		// insert PROCESSING — prevents concurrent duplicates
		try {
			idempotencyRepository.save(IdempotencyRecord.processing(requestReferenceNo, currentHash, ttlHours));
		} catch (DataIntegrityViolationException ex) {
			ErrorLogger.log(log, "Request with this reference number is already being processed", ex);
			throw new BusinessException("AD004");
		}

		// empty = no cached response, proceed with business logic
		return Optional.empty();
	}

	private String hash(Object requestBody) {
		try {
			String json = objectMapper.writeValueAsString(requestBody);
			MessageDigest digest = MessageDigest.getInstance("SHA-256");
			byte[] hashBytes = digest.digest(json.getBytes(StandardCharsets.UTF_8));
			return Base64.getEncoder().encodeToString(hashBytes);
		} catch (JsonNodeException | NoSuchAlgorithmException e) {
			ErrorLogger.log(log, "Request hashing failed", e);
			throw new UnexpectedException();
		}
	}

	@Transactional
	public void markSuccess(String requestReferenceNo, Object response) {
		try {
			String responseJson = objectMapper.writeValueAsString(response);
			idempotencyRepository.findByRequestReferenceNo(requestReferenceNo).ifPresent(record -> {
				record.markSuccess(responseJson, 200);
				idempotencyRepository.save(record);
				log.info("Marked SUCCESS");
			});
		} catch (JsonNodeException e) {
			ErrorLogger.log(log, "Failed to mark SUCCESS", e);
			throw new UnexpectedException();
		}
	}

	@Scheduled(cron = "0 0 0 * * *")
	@Transactional
	public void cleanupExpiredRecords() {
		idempotencyRepository.deleteExpiredRecords(LocalDateTime.now());
		log.info("Expired idempotency records cleaned up");
	}
}



