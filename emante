	protected void ensureMandateDoesNotExist(String instNo, String umrnNo) {
		if (acmmRepository.existsByInstNoAndUmrnNo(instNo, umrnNo)) {
			throw new BusinessException("0199", "A record for UMRN " + umrnNo + " already exists.");
		}
	}

	// ----------------------------------------------------------------------
	protected void ensureActive(String umrnStatus) {
		Set<String> ACTIVE = Set.of(MandateOperation.CREATE.getUmrnStatus(), MandateOperation.AMEND.getUmrnStatus());

		if (!ACTIVE.contains(umrnStatus)) {
//			throw new BusinessException("9065", "Mandate is not active.");
			throw new BusinessException("9065", "Mandate must be active to perform this action.");   
		}
	}

	// ----------------------------------------------------------------------
	protected void ensureStopped(String umrnStatus) {
		if (!umrnStatus.equals(MandateOperation.STOP.getUmrnStatus())) {
			throw new BusinessException("9066", "Mandate must be stopped to perform this action.");   
		}
	}

	// ----------------------------------------------------------------------
	protected void validateAccNo(String acctNo) {
		acctNo = Utility.sanitize(acctNo);
		acctNo = Utility.removeLeadingZeros(acctNo);

		if (acctNo == null || acctNo.length() != 11) {
			throw new BusinessException("0108", "Account number must be exactly 11 characters.");
		}

		if (!CalculateCheckDigit.validateCheckDigit(acctNo)) {
			throw new BusinessException("0108", "Invalid checkdigit.");
		}
	}

	// ----------------------------------------------------------------------
	protected void validateFrequency2(String frequency1, String frequency2) {
		if ("RCUR".equals(frequency1)) {
			if (frequency2 == null || frequency2.isBlank() || frequency2.matches("^0+$")) {
				throw new BusinessException("0432", "FREQUENCY2 is either blank or zero");
			}

			if (!ALLOWED_RCUR_FREQS.contains(frequency2)) {
				throw new BusinessException("0432", "Invalid frequency2.");
			}
		}
	}

	// ----------------------------------------------------------------------
	protected void validateAmount(BigDecimal requestAmount) {
		String amount1CardAmount = validationCacheService.getAmount1CardAmount();
		BigDecimal cardFileAmount = Utility.toBigDecimal(amount1CardAmount);

		if (requestAmount.compareTo(cardFileAmount) >= 0) {
			throw new BusinessException("8884", "Invalid amount.");
		}
	}

	// ----------------------------------------------------------------------
	protected void validateTredsAmount(String sponCode, String utilityCode, BigDecimal requestAmount) {
		if (sponCode != null && sponCode.length() == 11) {
			Optional<SponsorAllowCard> optional = sponserAllowCardRepo.findBySponsorBankAndUtilityCode(sponCode,
					utilityCode);

			if (optional.isPresent()) {
				BigDecimal tredsLimit = Utility.toBigDecimal(validationCacheService.getTredsLimitStr());

				if (requestAmount.compareTo(tredsLimit) >= 0) {
					throw new BusinessException("8884");
				}
			}
		}
	}

	// ----------------------------------------------------------------------
	protected void validateProduct1(EisMicroResponse eisMicroResponse, String sponCode, String utilityCode) {
		String accType = eisMicroResponse.getACCT_TYPE().trim();
		String intCat = eisMicroResponse.getINT_CAT().trim();

		SponsorAllowCard reqSponsorAllowCard = new SponsorAllowCard();
		reqSponsorAllowCard.setSponsorBank(sponCode);
		reqSponsorAllowCard.setUtilityCode(utilityCode);

		Set<String> product1CardValues = validationCacheService.getProduct1CardValues();
		Set<SponsorAllowCard> sponsorAllowCards = validationCacheService.getSponsorAllowCards();

		if (product1CardValues.contains(accType + intCat)) {
			if (!sponsorAllowCards.contains(reqSponsorAllowCard)) {
				throw new BusinessException("8883");
			}
		}
	}

	// ----------------------------------------------------------------------
	protected EisMicroResponse getValidatedEisMicroResponse(EisMicroResponse eisMicroResponse) {
		if (eisMicroResponse == null) {
			throw new BusinessException("AD005");
		}

		String responseStatus = eisMicroResponse.getRESPONSE_STATUS();

		if (responseStatus.equals("1")) {
			String eisMicroErrorCode = eisMicroResponse.getERROR_CODE();
			String eisMicroErrorDescription = eisMicroResponse.getERROR_DESCRIPTION();

			String errorCode = "0188";

			if (!(eisMicroErrorCode.equalsIgnoreCase("0188") || eisMicroErrorCode.equalsIgnoreCase("188"))) {
				errorCode = "AD008";
			}

			throw new EisMicroException(errorCode, eisMicroErrorCode + ":" + eisMicroErrorDescription);
		} else if (!responseStatus.equals("0")) {
			throw new BusinessException("AD006");
		}

		return eisMicroResponse;
	}
}



