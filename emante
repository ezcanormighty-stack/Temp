package com.tcs.aadesh.service;

import java.nio.charset.StandardCharsets;
import java.time.LocalDateTime;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.dao.DataAccessException;
import org.springframework.stereotype.Service;
import org.springframework.web.util.ContentCachingResponseWrapper;

import com.tcs.aadesh.constant.RequestConstants;
import com.tcs.aadesh.context.AuditContext;
import com.tcs.aadesh.dto.wrapper.CachedBodyHttpServletRequest;
import com.tcs.aadesh.entity.EmandateAuditLog;
import com.tcs.aadesh.entity.EmandateAuditLogId;
import com.tcs.aadesh.repository.AuditRepository;
import com.tcs.aadesh.util.ErrorLogger;

import tools.jackson.databind.JsonNode;
import tools.jackson.databind.ObjectMapper;

@Service
public class AuditService {
	private static final Logger log = LoggerFactory.getLogger(AuditService.class);

	private final AuditRepository auditRepository;
	private final ObjectMapper objectMapper;

	@Autowired
	public AuditService(AuditRepository auditRepository, ObjectMapper objectMapper) {
		this.auditRepository = auditRepository;
		this.objectMapper = objectMapper;
	}

	public void saveAuditLog(CachedBodyHttpServletRequest servletRequest,
			ContentCachingResponseWrapper servletResponse) {

		// 1. Request Body
		String decryptedRequest = readRequestBody(servletRequest);

		// 2. Response Body
		String plainResponse = new String(servletResponse.getContentAsByteArray(), StandardCharsets.UTF_8);

		// 3. Extract audit data
		AuditContext auditContext = extractAuditData(servletRequest, servletResponse, decryptedRequest, plainResponse);

		// 4. Build audit entity
		EmandateAuditLog auditLog = buildAuditLog(auditContext);

		// 5. Save to DB
		EmandateAuditLogId auditLogId = new EmandateAuditLogId(auditLog.getRequestReferenceNo(),
				auditLog.getEntryDate());

		try {
			if (!auditRepository.existsById(auditLogId)) {
				auditRepository.save(auditLog);
				log.info("Audit log saved successfully");
			} else {
				log.error("Audit log failure | Audit record already exist");
			}
		} catch (IllegalArgumentException | DataAccessException e) {
			ErrorLogger.log(log, e);
		}
	}
	
	// ---------------- HELPER FUNCTIONS ----------------
	private AuditContext extractAuditData(
			CachedBodyHttpServletRequest servletRequest,
			ContentCachingResponseWrapper servletResponse, 
			String decryptedRequest, 
			String plainResponse) {

		// 1. Extract Request Headers
		String sourceId = servletRequest.getHeader(RequestConstants.Headers.SOURCE_ID);
		String requestReferenceNo = servletRequest.getHeader(RequestConstants.Headers.REQ_REF_NO);
		
		// 2. Extract Response Headers
		String txnNo = servletResponse.getHeader(RequestConstants.Headers.TXN_NO);
		String txnName = servletResponse.getHeader(RequestConstants.Headers.TXN_NAME);

		// 3. Extract Request body fields
		JsonNode requestNode = objectMapper.readTree(decryptedRequest);
		String tellerNo = requestNode.path("TELLER_ID").asString(null);
		String umrnNo = requestNode.path("UMRN").asString(null);

		// 4. Extract Response body fields
		JsonNode responseNode = objectMapper.readTree(plainResponse);
		String responseStatus = responseNode.path("status").asString(null);

		JsonNode errorNode = responseNode.path("error");
		String errorCode = errorNode.path("errorCode").asString(null);
		String errorDescription = errorNode.path("errorDescription").asString(null);

		// 5. Client IP
		String clientIp = servletRequest.getHeader("X-Forwarded-For");
		if (clientIp == null || clientIp.isEmpty() || "unknown".equalsIgnoreCase(clientIp)) {
		    clientIp = servletRequest.getRemoteAddr();
		}   

		return new AuditContext(
				txnNo, 
				txnName, 
				responseStatus, 
				requestReferenceNo,
				sourceId,
				tellerNo, 
				umrnNo,
				decryptedRequest,
				plainResponse, 
				errorCode,
				errorDescription,
				clientIp,
				servletRequest.getRequestURI(),
				servletRequest.getMethod(),
				servletResponse.getStatus()
		);
	}
	
	private EmandateAuditLog buildAuditLog(AuditContext context) {
		EmandateAuditLog auditLog = new EmandateAuditLog();
		auditLog.setTxnNo(context.txnNo());
		auditLog.setTxnName(context.txnName());
		auditLog.setResponseStatus(context.responseStatus());
		auditLog.setRequestReferenceNo(context.requestReferenceNo());
		auditLog.setSourceId(context.sourceId());
		auditLog.setTellerNo(context.tellerNo());
		auditLog.setUmrnNo(context.umrnNo());
		auditLog.setRequestBody(context.requestBody());
		auditLog.setResponseBody(context.responseBody());
		auditLog.setErrorCode(context.errorCode());
		auditLog.setErrorDescription(context.errorDescription());
		auditLog.setClientIp(context.clientIp());
		auditLog.setRequestUri(context.requestUri());
		auditLog.setHttpMethod(context.httpMethod());
		auditLog.setHttpStatus(context.httpStatusCode());
		auditLog.setEntryDate(LocalDateTime.now());

		System.out.println("AuditLog: " + auditLog.toString());

		return auditLog;
	}

	private String readRequestBody(CachedBodyHttpServletRequest servletRequest) {
		return new String(servletRequest.getCachedBody(), StandardCharsets.UTF_8);
	}
}

