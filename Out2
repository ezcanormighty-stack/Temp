package com.tcs.npci.outward.config.properties;

import org.springframework.boot.context.properties.ConfigurationProperties;
import org.springframework.stereotype.Component;
import org.springframework.validation.annotation.Validated;

import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;

@Component
@Validated
@ConfigurationProperties(prefix = "sftp")
public class SftpProperties {

    @NotBlank(message = "'sftp.host' must be set and cannot be empty")
    private String host;

    @NotNull(message = "'sftp.port' must be set")
    private Integer port;

    @NotBlank(message = "'sftp.username' must be set and cannot be empty")
    private String username;

    private String password; // Optional if using private key authentication exclusively

    @NotBlank(message = "'sftp.private-key-path' must be set and cannot be empty")
    private String privateKeyPath;

    @NotBlank(message = "'sftp.remote-dest-path' must be set and cannot be empty")
    private String remoteDestPath;

    public String getHost() {
        return host;
    }

    public void setHost(String host) {
        this.host = host;
    }

    public Integer getPort() {
        return port;
    }

    public void setPort(Integer port) {
        this.port = port;
    }

    public String getUsername() {
        return username;
    }

    public void setUsername(String username) {
        this.username = username;
    }

    public String getPassword() {
        return password;
    }

    public void setPassword(String password) {
        this.password = password;
    }

    public String getPrivateKeyPath() {
        return privateKeyPath;
    }

    public void setPrivateKeyPath(String privateKeyPath) {
        this.privateKeyPath = privateKeyPath;
    }

    public String getRemoteDestPath() {
        return remoteDestPath;
    }

    public void setRemoteDestPath(String remoteDestPath) {
        this.remoteDestPath = remoteDestPath;
    }
}




