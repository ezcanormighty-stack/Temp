import java.util.Comparator;
import java.util.stream.Stream;
import java.util.zip.ZipEntry;
import java.util.zip.ZipOutputStream;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

@Component
public class ZipUtility {

    private static final Logger log = LoggerFactory.getLogger(ZipUtility.class);

    /**
     * Zips the contents of the given source folder into the specified zip file path[span_0](start_span)[span_0](end_span).
     * 
     * @param sourceFolderPath The directory containing files to zip.
     * @param zippedPath The destination path for the .zip file.
     * @throws IOException If an I/O error occurs.
     */
    public void zipFolder(Path sourceFolderPath, Path zippedPath) throws IOException {
        log.debug("Starting to zip folder: {} to {}", sourceFolderPath, zippedPath);
        
        // Ensure parent directories exist
        if (zippedPath.getParent() != null && !Files.exists(zippedPath.getParent())) {
            Files.createDirectories(zippedPath.getParent());
        }

        try (ZipOutputStream zs = new ZipOutputStream(Files.newOutputStream(zippedPath));
             Stream<Path> paths = Files.walk(sourceFolderPath)) {
             
            paths.filter(path -> !Files.isDirectory(path)).forEach(path -> {
                ZipEntry zipEntry = new ZipEntry(sourceFolderPath.relativize(path).toString());
                try {
                    zs.putNextEntry(zipEntry);
                    Files.copy(path, zs);
                    zs.closeEntry();
                } catch (IOException e) {
                    log.error("Failed to add file {} to zip", path.getFileName(), e);
                    throw new RuntimeException("Zipping process failed for file: " + path.getFileName(), e);
                }
            });
        }
        log.debug("Successfully zipped folder to {}", zippedPath);
    }

    /**
     * Deletes a directory and all of its contents[span_1](start_span)[span_1](end_span).
     * 
     * @param dir The directory to delete.
     * @throws IOException If an I/O error occurs.
     */
    public void deleteDirectory(Path dir) throws IOException {
        if (!Files.exists(dir)) {
            log.debug("Directory {} does not exist, skipping deletion.", dir);
            return;
        }

        try (Stream<Path> walk = Files.walk(dir)) {
            walk.sorted(Comparator.reverseOrder())
                .forEach(path -> {
                    try {
                        Files.delete(path);
                    } catch (IOException e) {
                        log.error("Failed to delete path: {}", path, e);
                    }
                });
        }
        log.debug("Successfully deleted directory {}", dir);
    }
}




package com.tcs.npci.outward.util;

import java.nio.charset.StandardCharsets;
import java.security.InvalidAlgorithmParameterException;
import java.security.InvalidKeyException;
import java.security.NoSuchAlgorithmException;
import java.security.Security;
import java.util.Base64;

import javax.crypto.BadPaddingException;
import javax.crypto.Cipher;
import javax.crypto.IllegalBlockSizeException;
import javax.crypto.NoSuchPaddingException;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.SecretKeySpec;

import org.bouncycastle.jce.provider.BouncyCastleProvider;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

@Component
public class AesEncryptionUtility {
    
    private static final Logger log = LoggerFactory.getLogger(AesEncryptionUtility.class);
    private static final String AES_TRANSFORMATION = "AES/GCM/NoPadding";

    public AesEncryptionUtility() {
        Security.addProvider(new BouncyCastleProvider());
    }

    /**
     * Decrypts AES encrypted strings (e.g., database or SFTP credentials from properties) 
     * using a provided Base64 encoded Key and Initialization Vector (IV)[span_0](start_span)[span_0](end_span).
     * 
     * @param key Base64 encoded AES key
     * @param initVector Base64 encoded Initialization Vector
     * @param encrypted The encrypted string to decrypt
     * @return The decrypted plain text string
     */
    public String aesDecrypt(String key, String initVector, String encrypted) {
        if (encrypted == null || encrypted.isBlank()) {
            return encrypted;
        }

        try {
            byte[] keyBytes = Base64.getDecoder().decode(key.getBytes(StandardCharsets.UTF_8));
            byte[] ivBytes = Base64.getDecoder().decode(initVector.getBytes(StandardCharsets.UTF_8));

            SecretKeySpec skeySpec = new SecretKeySpec(keyBytes, "AES");
            
            // 128-bit authentication tag length[span_1](start_span)[span_1](end_span)
            GCMParameterSpec gcmParameterSpec = new GCMParameterSpec(128, ivBytes); 
            
            Cipher cipher = Cipher.getInstance(AES_TRANSFORMATION);
            cipher.init(Cipher.DECRYPT_MODE, skeySpec, gcmParameterSpec);

            byte[] originalBytes = cipher.doFinal(Base64.getDecoder().decode(encrypted));
            
            // Remove null characters if any were padded[span_2](start_span)[span_2](end_span)
            String decryptedString = new String(originalBytes, StandardCharsets.UTF_8).replace("\0", "");
            
            return decryptedString;

        } catch (NoSuchAlgorithmException | NoSuchPaddingException | InvalidKeyException |
                 InvalidAlgorithmParameterException | IllegalBlockSizeException | BadPaddingException e) {
            log.error("Error decrypting AES value: {}", e.getMessage(), e);
            throw new RuntimeException("Failed to decrypt secure property value", e);
        }
    }
}



package com.tcs.npci.outward.exception.handler;

import java.lang.reflect.Method;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.aop.interceptor.AsyncUncaughtExceptionHandler;
import org.springframework.stereotype.Component;

import com.tcs.npci.outward.exception.BatchProcessingException;
import com.tcs.npci.outward.exception.CryptoOperationException;
import com.tcs.npci.outward.util.ErrorLogger;

@Component
public class AsyncExceptionHandler implements AsyncUncaughtExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(AsyncExceptionHandler.class);

    @Override
    public void handleUncaughtException(Throwable ex, Method method, Object... params) {
        
        if (ex instanceof BatchProcessingException batchEx) {
            log.error("Batch Processing Failure | Code: {} | Message: {}", 
                    batchEx.getErrorCode(), batchEx.getErrorMessage());
        } 
        else if (ex instanceof CryptoOperationException cryptoEx) {
            log.error("Crypto Operation Failure | Code: {} | Message: {}", 
                    cryptoEx.getErrorCode(), cryptoEx.getErrorMessage());
        } 
        else if (ex instanceof Exception genericEx) {
            ErrorLogger.log(log, "Unhandled exception in background thread execution", genericEx);
        } else {
            log.error("Critical system error in async thread: {}", ex.getMessage(), ex);
        }
    }
}



package com.tcs.npci.outward.util;

import org.slf4j.Logger;
import org.springframework.stereotype.Component;

@Component
public final class ErrorLogger {

    static String currentPackage = ErrorLogger.class.getPackage().getName();
    static int lastDotIndex = currentPackage.lastIndexOf('.');
    private static final String APP_BASE_PACKAGE = currentPackage.substring(0, lastDotIndex);

    private ErrorLogger() {
    }

    public static void log(Logger log, Exception e) {
        if (e == null) {
            log.error("{} | Unknown error (exception was null)");
            return;
        }

        StackTraceElement origin = findApplicationTrace(e);
        log.error("{} in {}.{}({}:{}) | {}", e.getClass().getSimpleName(), origin.getClassName(),
                origin.getMethodName(), origin.getFileName(), origin.getLineNumber(), safeMessage(e));
    }

    public static void log(Logger log, String message, Exception e) {
        if (e == null) {
            log.error("{} | Unknown error (exception was null)", message);
            return;
        }

        StackTraceElement origin = findApplicationTrace(e);
        log.error("{} | {} in {}.{}({}:{}) | {}", message, e.getClass().getSimpleName(), origin.getClassName(),
                origin.getMethodName(), origin.getFileName(), origin.getLineNumber(), safeMessage(e));
    }

    private static StackTraceElement findApplicationTrace(Exception e) {
        for (StackTraceElement element : e.getStackTrace()) {
            if (element.getClassName().startsWith(APP_BASE_PACKAGE)) {
                return element;
            }
        }
        return e.getStackTrace().length > 0 ? e.getStackTrace()[0]
                : new StackTraceElement("UnknownClass", "UnknownMethod", "UnknownFile", -1);
    }

    private static String safeMessage(Exception e) {
        return (e.getMessage() == null || e.getMessage().isBlank()) ? "(no message)" : e.getMessage();
    }
}
