import org.bouncycastle.bcpg.ArmoredOutputStream;
import org.bouncycastle.jce.provider.BouncyCastleProvider;
import org.bouncycastle.openpgp.PGPCompressedData;
import org.bouncycastle.openpgp.PGPCompressedDataGenerator;
import org.bouncycastle.openpgp.PGPEncryptedData;
import org.bouncycastle.openpgp.PGPEncryptedDataGenerator;
import org.bouncycastle.openpgp.PGPLiteralData;
import org.bouncycastle.openpgp.PGPLiteralDataGenerator;
import org.bouncycastle.openpgp.PGPPublicKey;
import org.bouncycastle.openpgp.operator.jcajce.JcaPGPKeyConverter;
import org.bouncycastle.openpgp.operator.jcajce.JcePGPDataEncryptorBuilder;
import org.bouncycastle.openpgp.operator.jcajce.JcePublicKeyKeyEncryptionMethodGenerator;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;

import com.tcs.npci.outward.config.properties.CryptoProperties;
import com.tcs.npci.outward.constant.AppConstants;
import com.tcs.npci.outward.exception.CryptoOperationException;

import jakarta.annotation.PostConstruct;

@Component
public class PgpEncryptionUtility {

    private static final Logger log = LoggerFactory.getLogger(PgpEncryptionUtility.class);

    private final CryptoProperties cryptoProperties;
    private PGPPublicKey pgpPublicKey;

    public PgpEncryptionUtility(CryptoProperties cryptoProperties) {
        this.cryptoProperties = cryptoProperties;
    }

    @PostConstruct
    public void init() {
        try {
            Security.addProvider(new BouncyCastleProvider());
            String publicKeyPath = cryptoProperties.getPgp().getPublicKeyPath();
            
            // Extract standard Java PublicKey from X.509 certificate[span_0](start_span)[span_0](end_span)
            PublicKey javaPublicKey;
            try (FileInputStream fis = new FileInputStream(publicKeyPath)) {
                CertificateFactory certFactory = CertificateFactory.getInstance("X.509");
                java.security.cert.Certificate certificate = certFactory.generateCertificate(fis);
                javaPublicKey = certificate.getPublicKey();
            }

            // Convert to BouncyCastle PGPPublicKey[span_1](start_span)[span_1](end_span)
            this.pgpPublicKey = new JcaPGPKeyConverter()
                    .getPGPPublicKey(PGPPublicKey.RSA_GENERAL, javaPublicKey, new Date());
                    
            log.info("PGP Encryption Utility initialized successfully with public key.");
        } catch (Exception e) {
            log.error("Failed to initialize PGP public key", e);
            throw new RuntimeException("Could not initialize PGP keys", e);
        }
    }

    /**
     * Encrypts the signed byte array using BouncyCastle PGP APIs[span_2](start_span)[span_2](end_span).
     */
    public void encryptFile(Path inputPath, Path outputPath, String internalFileName) {
        try {
            byte[] inputBytes = Files.readAllBytes(inputPath);
            
            try (OutputStream fileOut = new BufferedOutputStream(Files.newOutputStream(outputPath));
                 OutputStream armoredOut = new ArmoredOutputStream(fileOut)) {

                // 1. Compress the data into ZIP format[span_3](start_span)[span_3](end_span)
                ByteArrayOutputStream bOut = new ByteArrayOutputStream();
                PGPCompressedDataGenerator comData = new PGPCompressedDataGenerator(PGPCompressedData.ZIP);
                PGPLiteralDataGenerator lGen = new PGPLiteralDataGenerator();
                
                try (OutputStream pOut = lGen.open(comData.open(bOut), PGPLiteralData.BINARY, internalFileName, inputBytes.length, new Date())) {
                    pOut.write(inputBytes);
                }
                comData.close();

                // 2. Configure AES-256 encryption builder[span_4](start_span)[span_4](end_span)
                JcePGPDataEncryptorBuilder encryptorBuilder = new JcePGPDataEncryptorBuilder(PGPEncryptedData.AES_256)
                        .setWithIntegrityPacket(true)
                        .setSecureRandom(new SecureRandom())
                        .setProvider("BC");

                PGPEncryptedDataGenerator encGen = new PGPEncryptedDataGenerator(encryptorBuilder);
                encGen.addMethod(new JcePublicKeyKeyEncryptionMethodGenerator(pgpPublicKey).setProvider("BC"));

                // 3. Encrypt the compressed bytes[span_5](start_span)[span_5](end_span)
                byte[] compressedBytes = bOut.toByteArray();
                try (OutputStream cOut = encGen.open(armoredOut, compressedBytes.length)) {
                    cOut.write(compressedBytes);
                }
            }
        } catch (Exception e) {
            throw new CryptoOperationException(AppConstants.TECHNICAL_ERROR.getValue(), "Failed to PGP encrypt the file", e);
        }
    }
}




