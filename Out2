package com.tcs.npci.outward.exception.handler;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.dao.DataAccessException;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

import com.tcs.npci.outward.constant.AppConstants;
import com.tcs.npci.outward.exception.BatchProcessingException;
import com.tcs.npci.outward.exception.CryptoOperationException;

import java.util.HashMap;
import java.util.Map;

@RestControllerAdvice
public class GlobalExceptionHandler {

    private static final Logger log = LoggerFactory.getLogger(GlobalExceptionHandler.class);

    private ResponseEntity> buildErrorResponse(Exception ex, HttpStatus status, String errorCode, String errorMessage) {
        log.error("{} | {} | {}", errorCode, errorMessage, ex.getMessage(), ex);
        
        Map<String, Object> errorResponse = new HashMap<>();
        errorResponse.put("status", "FAILURE");
        errorResponse.put("errorCode", errorCode);
        errorResponse.put("errorMessage", errorMessage != null ? errorMessage : ex.getMessage());
        errorResponse.put("timestamp", java.time.LocalDateTime.now().toString());

        return ResponseEntity.status(status).body(errorResponse);
    }

    @ExceptionHandler(BatchProcessingException.class)
    public ResponseEntity> handleBatchProcessing(BatchProcessingException ex) {
        return buildErrorResponse(
                ex, 
                HttpStatus.BAD_REQUEST, 
                ex.getErrorCode(),
                ex.getErrorMessage()
        );
    }

    @ExceptionHandler(CryptoOperationException.class)
    public ResponseEntity> handleCryptoOperation(CryptoOperationException ex) {
        return buildErrorResponse(
                ex, 
                HttpStatus.INTERNAL_SERVER_ERROR, 
                ex.getErrorCode(),
                ex.getErrorMessage()
        );
    }

    @ExceptionHandler(DataAccessException.class)
    public ResponseEntity> handleDataAccess(DataAccessException ex) {
        return buildErrorResponse(
                ex, 
                HttpStatus.INTERNAL_SERVER_ERROR, 
                AppConstants.TECHNICAL_ERROR.getValue(),
                "A database error occurred during file log update."
        );
    }

    @ExceptionHandler(Exception.class)
    public ResponseEntity> handleGeneric(Exception ex) {
        return buildErrorResponse(
                ex, 
                HttpStatus.INTERNAL_SERVER_ERROR, 
                AppConstants.TECHNICAL_ERROR.getValue(),
                "An unexpected system error occurred during outward file processing."
        );
    }
}


package com.tcs.npci.outward.service;

import java.io.IOException;
import java.nio.file.DirectoryStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Service;

import com.tcs.npci.outward.config.properties.DirectoryProperties;
import com.tcs.npci.outward.exception.BatchProcessingException;

@Service
public class DirectoryPollingService {

    private static final Logger log = LoggerFactory.getLogger(DirectoryPollingService.class);

    private final DirectoryProperties directoryProperties;
    private final FileBatchingService fileBatchingService;

    public DirectoryPollingService(DirectoryProperties directoryProperties, FileBatchingService fileBatchingService) {
        this.directoryProperties = directoryProperties;
        this.fileBatchingService = fileBatchingService;
    }

    /**
     * Polls the source directory at a fixed interval.
     * Scans subdirectories (e.g., CREATE, AMEND, CANCEL) and hands them off to the batching service.
     */
    @Scheduled(fixedDelayString = "${polling.fixed-delay:15000}")
    public void pollSourceDirectory() {
        Path sourceDir = Paths.get(directoryProperties.getSource());

        if (!Files.exists(sourceDir) || !Files.isDirectory(sourceDir)) {
            log.warn("Source directory does not exist or is not a directory: {}", sourceDir);
            return;
        }

        try (DirectoryStream<Path> stream = Files.newDirectoryStream(sourceDir, Files::isDirectory)) {
            for (Path subFolder : stream) {
                log.debug("Scanning folder: {}", subFolder.getFileName());
                try {
                    // Hand off to the batching service which will group the 1 XML + 2 Images (TIF/JPG) logic
                    fileBatchingService.processDirectory(subFolder);
                } catch (BatchProcessingException e) {
                    log.error("Batch processing failed for folder {}: {}", subFolder.getFileName(), e.getMessage());
                } catch (Exception e) {
                    log.error("Unexpected error processing folder {}: {}", subFolder.getFileName(), e.getMessage(), e);
                }
            }
        } catch (IOException e) {
            log.error("Error accessing source directory: {}", sourceDir, e);
        }
    }
}




package com.tcs.npci.outward.service;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.sql.Date;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ExecutorService;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import com.tcs.npci.outward.config.properties.DirectoryProperties;
import com.tcs.npci.outward.constant.AppConstants;
import com.tcs.npci.outward.entity.OutwardFileLog;
import com.tcs.npci.outward.repository.OutwardFileLogRepository;

@Service
public class FileBatchingService {

    private static final Logger log = LoggerFactory.getLogger(FileBatchingService.class);
    
    private final DirectoryProperties directoryProperties;
    private final OutwardFileLogRepository outwardFileLogRepository;
    private final CryptoOrchestrationService cryptoOrchestrationService;
    private final ExecutorService fileProcessingExecutor;

    private static final int TARGET_SETS = Integer.parseInt(AppConstants.BATCH_XML_LIMIT.getValue());

    public FileBatchingService(DirectoryProperties directoryProperties,
                               OutwardFileLogRepository outwardFileLogRepository,
                               CryptoOrchestrationService cryptoOrchestrationService,
                               ExecutorService fileProcessingExecutor) {
        this.directoryProperties = directoryProperties;
        this.outwardFileLogRepository = outwardFileLogRepository;
        this.cryptoOrchestrationService = cryptoOrchestrationService;
        this.fileProcessingExecutor = fileProcessingExecutor;
    }

    public void processDirectory(Path subFolder) throws IOException {
        String folderName = subFolder.getFileName().toString();
        List<Path> allFiles = Files.list(subFolder).filter(Files::isRegularFile).toList();

        if (allFiles.isEmpty()) {
            return;
        }

        // Group files by their base name to form sets of (XML, TIF/TIFF, JPG/JPEG)
        Map<String, FileSet> groupedFiles = new HashMap<>();
        for (Path file : allFiles) {
            String fileName = file.getFileName().toString();
            String baseName = getBaseName(fileName);
            String extension = getExtension(fileName).toLowerCase();

            groupedFiles.putIfAbsent(baseName, new FileSet(baseName));
            FileSet set = groupedFiles.get(baseName);

            if (extension.equals("xml")) {
                set.setXmlFile(file);
            } else if (extension.equals("tif") || extension.equals("tiff")) {
                set.setTifFile(file);
            } else if (extension.equals("jpg") || extension.equals("jpeg")) {
                set.setJpgFile(file);
            }
        }

        List<FileSet> validSets = new ArrayList<>();
        for (FileSet set : groupedFiles.values()) {
            if (set.isValidSet()) {
                validSets.add(set);
            }
        }

        log.info("Found {} complete valid file sets in {}", validSets.size(), folderName);

        // Process in chunks of 100 sets (100 XML + 200 Images = 300 files)
        int processedCount = 0;
        while (validSets.size() - processedCount >= TARGET_SETS) {
            List<FileSet> batchSets = validSets.subList(processedCount, processedCount + TARGET_SETS);
            createBatchAndProcess(batchSets, folderName);
            processedCount += TARGET_SETS;
        }
        
        // Note: Remaining sets (< 100) are left in the directory for the next polling cycle, 
        // unless an EOD override is implemented.
    }

    private void createBatchAndProcess(List<FileSet> batchSets, String folderName) {
        String currDate = LocalDate.now().format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        String batchFolderName = "MMS-" + folderName + "-SBIN-SBIN-" + currDate + "-" + UUID.randomUUID().toString().substring(0, 6).toUpperCase() + "-ACCEPT";
        
        Path destDir = Paths.get(directoryProperties.getToProcess(), folderName, batchFolderName);
        
        try {
            Files.createDirectories(destDir);
            
            List<Path> batchFiles = new ArrayList<>();
            Date entryDate = new Date(System.currentTimeMillis());

            for (FileSet set : batchSets) {
                batchFiles.add(moveAndLogFile(set.getXmlFile(), destDir, folderName, batchFolderName, entryDate));
                batchFiles.add(moveAndLogFile(set.getTifFile(), destDir, folderName, batchFolderName, entryDate));
                batchFiles.add(moveAndLogFile(set.getJpgFile(), destDir, folderName, batchFolderName, entryDate));
            }

            log.info("Batch ready: {} files in {}. Triggering async crypto process.", batchFiles.size(), batchFolderName);

            fileProcessingExecutor.execute(() -> {
                cryptoOrchestrationService.processBatch(destDir.toFile(), folderName, batchFolderName, batchFiles.size());
            });

        } catch (IOException e) {
            log.error("Failed to create batch directory or move files for batch: {}", batchFolderName, e);
        }
    }

    private Path moveAndLogFile(Path sourceFile, Path destDir, String folderName, String batchFolderName, Date entryDate) throws IOException {
        String fileName = sourceFile.getFileName().toString();
        Path destFile = destDir.resolve(fileName);
        
        Files.move(sourceFile, destFile, StandardCopyOption.REPLACE_EXISTING);

        OutwardFileLog fileLog = new OutwardFileLog();
        fileLog.setFileName(fileName);
        fileLog.setFolderName(batchFolderName);
        fileLog.setProcessType("ENC");
        fileLog.setZone("OTH"); // Can be derived dynamically if needed
        fileLog.setEntryDate(entryDate);
        fileLog.setLastUpdatedTime(LocalDateTime.now());
        
        outwardFileLogRepository.save(fileLog);
        
        return destFile;
    }

    private String getBaseName(String fileName) {
        int dotIndex = fileName.lastIndexOf('.');
        return (dotIndex == -1) ? fileName : fileName.substring(0, dotIndex);
    }

    private String getExtension(String fileName) {
        int dotIndex = fileName.lastIndexOf('.');
        return (dotIndex == -1) ? "" : fileName.substring(dotIndex + 1);
    }

    private static class FileSet {
        private final String baseName;
        private Path xmlFile;
        private Path tifFile;
        private Path jpgFile;

        public FileSet(String baseName) {
            this.baseName = baseName;
        }

        public void setXmlFile(Path xmlFile) { this.xmlFile = xmlFile; }
        public void setTifFile(Path tifFile) { this.tifFile = tifFile; }
        public void setJpgFile(Path jpgFile) { this.jpgFile = jpgFile; }

        public Path getXmlFile() { return xmlFile; }
        public Path getTifFile() { return tifFile; }
        public Path getJpgFile() { return jpgFile; }

        public boolean isValidSet() {
            return xmlFile != null && tifFile != null && jpgFile != null;
        }
    }
}



package com.tcs.npci.outward.service;

import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardCopyOption;
import java.sql.Date;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.UUID;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import com.tcs.npci.outward.config.properties.DirectoryProperties;
import com.tcs.npci.outward.constant.ErrorConstants;
import com.tcs.npci.outward.entity.OutwardEncLog;
import com.tcs.npci.outward.exception.CryptoOperationException;
import com.tcs.npci.outward.repository.OutwardEncLogRepository;
import com.tcs.npci.outward.util.PgpEncryptionUtility;
import com.tcs.npci.outward.util.SignatureUtility;
import com.tcs.npci.outward.util.ZipUtility;

@Service
public class CryptoOrchestrationService {

    private static final Logger log = LoggerFactory.getLogger(CryptoOrchestrationService.class);

    private final DirectoryProperties directoryProperties;
    private final OutwardEncLogRepository outwardEncLogRepository;
    private final ZipUtility zipUtility;
    private final SignatureUtility signatureUtility;
    private final PgpEncryptionUtility pgpEncryptionUtility;
    private final SftpUploadService sftpUploadService;

    public CryptoOrchestrationService(DirectoryProperties directoryProperties,
                                      OutwardEncLogRepository outwardEncLogRepository,
                                      ZipUtility zipUtility,
                                      SignatureUtility signatureUtility,
                                      PgpEncryptionUtility pgpEncryptionUtility,
                                      SftpUploadService sftpUploadService) {
        this.directoryProperties = directoryProperties;
        this.outwardEncLogRepository = outwardEncLogRepository;
        this.zipUtility = zipUtility;
        this.signatureUtility = signatureUtility;
        this.pgpEncryptionUtility = pgpEncryptionUtility;
        this.sftpUploadService = sftpUploadService;
    }

    public void processBatch(File batchFolder, String type, String batchFolderName, int totalNoOfRecords) {
        String referenceNumber = "SBIN" + UUID.randomUUID().toString().replace("-", "").substring(0, 10).toUpperCase();
        
        OutwardEncLog encLog = new OutwardEncLog();
        encLog.setReferenceNumber(referenceNumber);
        encLog.setFileName(batchFolderName);
        encLog.setFileType(type);
        encLog.setTotalNoOfRecords(totalNoOfRecords);
        encLog.setZone("OTH");
        encLog.setEntryDate(new Date(System.currentTimeMillis()));
        encLog.setFileCopiedTime(LocalDateTime.now());
        encLog.setLastUpdatedTime(LocalDateTime.now());

        String sourcePath = batchFolder.getAbsolutePath();
        Path zipFilePath = Paths.get(directoryProperties.getZipped(), batchFolderName + ".zip");
        Path signedFilePath = Paths.get(directoryProperties.getSigned(), batchFolderName + ".zip");
        Path encryptedFilePath = Paths.get(directoryProperties.getDestination(), batchFolderName + ".zip");

        boolean isZipped = false;
        boolean isSigned = false;
        boolean isEncrypted = false;

        try {
            // 1. Zipping
            zipUtility.zipFolder(Paths.get(sourcePath), zipFilePath);
            isZipped = true;
            updateLogStatus(encLog, ErrorConstants.ZIP_SUCCESS, ErrorConstants.ZIPPED_FILE);

            // 2. Signing
            signatureUtility.signAndWrapXml(zipFilePath, signedFilePath);
            isSigned = true;
            updateLogStatus(encLog, ErrorConstants.SIGN_SUCCESS, ErrorConstants.SIGNED_FILE);

            // 3. Encrypting
            pgpEncryptionUtility.encryptFile(signedFilePath, encryptedFilePath, batchFolderName + ".zip");
            isEncrypted = true;
            updateLogStatus(encLog, ErrorConstants.ENCRYPTION_SUCCESS, ErrorConstants.ENCRYPTED_FILE);
            log.info("Successfully encrypted batch file: {}", batchFolderName);

            // 4. SFTP Upload
            boolean uploadSuccess = sftpUploadService.uploadFile(type, encryptedFilePath);
            if (uploadSuccess) {
                log.info("Successfully uploaded {} to NPCI server", batchFolderName);
            } else {
                log.warn("SFTP Upload failed for {}", batchFolderName);
            }

            // 5. Backup & Cleanup
            createBackups(zipFilePath, encryptedFilePath, batchFolderName);
            cleanupSourceFiles(Paths.get(sourcePath), zipFilePath, signedFilePath, encryptedFilePath);

        } catch (Exception e) {
            log.error("Crypto orchestration failed for batch: {}", batchFolderName, e);
            handleFailure(encLog, batchFolderName, sourcePath, zipFilePath, signedFilePath, isZipped, isSigned, isEncrypted);
        } finally {
            encLog.setLastUpdatedTime(LocalDateTime.now());
            outwardEncLogRepository.save(encLog);
        }
    }

    private void updateLogStatus(OutwardEncLog logEntity, ErrorConstants status, ErrorConstants encType) {
        logEntity.setStatus(status.toString());
        logEntity.setStatusEnc(status.name());
        logEntity.setEncryptionType(encType.toString());
        logEntity.setLastUpdatedTime(LocalDateTime.now());
        outwardEncLogRepository.save(logEntity);
    }

    private void handleFailure(OutwardEncLog encLog, String batchFolderName, String sourcePath, 
                               Path zipFilePath, Path signedFilePath, 
                               boolean isZipped, boolean isSigned, boolean isEncrypted) {
        try {
            if (!isZipped) {
                updateLogStatus(encLog, ErrorConstants.ZIP_FAILURE, ErrorConstants.ZIPPED_FILE);
                encLog.setErrorCode(ErrorConstants.ERR77.name());
                Files.move(Paths.get(sourcePath), Paths.get(directoryProperties.getZippingFailed(), batchFolderName), StandardCopyOption.ATOMIC_MOVE);
            } else if (!isSigned) {
                updateLogStatus(encLog, ErrorConstants.SIGN_FAILURE, ErrorConstants.ZIPPED_FILE);
                encLog.setErrorCode(ErrorConstants.ERR78.name());
                zipUtility.deleteDirectory(Paths.get(sourcePath));
                Files.move(zipFilePath, Paths.get(directoryProperties.getSigningFailed(), batchFolderName + ".zip"), StandardCopyOption.REPLACE_EXISTING);
            } else if (!isEncrypted) {
                updateLogStatus(encLog, ErrorConstants.ENCRYPTION_FAILURE, ErrorConstants.SIGNED_FILE);
                encLog.setErrorCode(ErrorConstants.ERR79.name());
                zipUtility.deleteDirectory(Paths.get(sourcePath));
                Files.deleteIfExists(zipFilePath);
                Files.move(signedFilePath, Paths.get(directoryProperties.getEncryptingFailed(), batchFolderName + ".zip"), StandardCopyOption.REPLACE_EXISTING);
            }
        } catch (IOException e) {
            log.error("Failed to move files to failure directories for {}", batchFolderName, e);
            throw new CryptoOperationException(AppConstants.TECHNICAL_ERROR.getValue(), "Failure cleanup handling aborted", e);
        }
    }

    private void createBackups(Path zipFilePath, Path encryptedFilePath, String batchFolderName) throws IOException {
        String currDate = LocalDate.now().format(DateTimeFormatter.ofPattern("ddMMyyyy"));
        
        Path sourceBackupDir = Paths.get(directoryProperties.getBackup(), "SourceFilesBackUp", currDate);
        Files.createDirectories(sourceBackupDir);
        Files.copy(zipFilePath, sourceBackupDir.resolve(batchFolderName + ".zip"), StandardCopyOption.REPLACE_EXISTING);

        Path encBackupDir = Paths.get(directoryProperties.getBackup(), "EncryptedFilesBackUp", currDate);
        Files.createDirectories(encBackupDir);
        Files.copy(encryptedFilePath, encBackupDir.resolve(batchFolderName + ".zip"), StandardCopyOption.REPLACE_EXISTING);
    }

    private void cleanupSourceFiles(Path sourcePath, Path zipFilePath, Path signedFilePath, Path encryptedFilePath) {
        try {
            zipUtility.deleteDirectory(sourcePath);
            Files.deleteIfExists(zipFilePath);
            Files.deleteIfExists(signedFilePath);
            Files.deleteIfExists(encryptedFilePath);
        } catch (IOException e) {
            log.error("Failed to clean up intermediate files", e);
        }
    }
}




package com.tcs.npci.outward.service;

import java.io.InputStream;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.Properties;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import com.jcraft.jsch.ChannelSftp;
import com.jcraft.jsch.JSch;
import com.jcraft.jsch.JSchException;
import com.jcraft.jsch.Session;
import com.jcraft.jsch.SftpException;
import com.tcs.npci.outward.config.properties.SftpProperties;

@Service
public class SftpUploadService {

    private static final Logger log = LoggerFactory.getLogger(SftpUploadService.class);

    private final SftpProperties sftpProperties;

    public SftpUploadService(SftpProperties sftpProperties) {
        this.sftpProperties = sftpProperties;
    }

    /**
     * Uploads the encrypted zip file to the NPCI SFTP server using JSch[span_0](start_span)[span_0](end_span).
     * 
     * @param type The transaction type (e.g., "CREATE", "AMEND", "CANCEL") to determine the sub-directory[span_1](start_span)[span_1](end_span).
     * @param encryptedFilePath The local path to the encrypted file.
     * @return true if upload is successful, false otherwise.
     */
    public boolean uploadFile(String type, Path encryptedFilePath) {
        Session session = null;
        ChannelSftp channel = null;

        try {
            JSch jsch = new JSch();
            
            // Add private key for authentication[span_2](start_span)[span_2](end_span)
            jsch.addIdentity(sftpProperties.getPrivateKeyPath().trim());

            session = jsch.getSession(
                sftpProperties.getUsername(), 
                sftpProperties.getHost(), 
                sftpProperties.getPort()
            );

            // Bypass strict host key checking for automated headless connections[span_3](start_span)[span_3](end_span)
            Properties config = new Properties();
            config.put("StrictHostKeyChecking", "no");
            config.put("PreferredAuthentications", "publickey");
            session.setConfig(config);

            log.debug("Connecting to SFTP session at {}:{}", sftpProperties.getHost(), sftpProperties.getPort());
            session.connect(30000); // 30-second timeout

            channel = (ChannelSftp) session.openChannel("sftp");
            channel.connect(30000);

            // Determine remote destination based on file type (CREATE, AMEND, CANCEL)[span_4](start_span)[span_4](end_span)
            String remoteDir = getRemoteDirectoryForType(type);
            channel.cd(remoteDir);

            // Upload the file[span_5](start_span)[span_5](end_span)
            try (InputStream inputStream = Files.newInputStream(encryptedFilePath)) {
                String fileName = encryptedFilePath.getFileName().toString();
                log.info("Uploading file {} to remote directory {}", fileName, remoteDir);
                channel.put(inputStream, fileName);
            }

            return true;

        } catch (JSchException e) {
            log.error("SFTP Connection error: {}", e.getMessage(), e);
        } catch (SftpException e) {
            log.error("SFTP Protocol error during file transfer: {}", e.getMessage(), e);
        } catch (Exception e) {
            log.error("Unexpected error during SFTP upload: {}", e.getMessage(), e);
        } finally {
            disconnect(channel, session);
        }

        return false;
    }

    /**
     * Resolves the remote directory by appending the transaction type to the base remote path.
     */
    private String getRemoteDirectoryForType(String type) {
        String basePath = sftpProperties.getRemoteDestPath().trim();
        // Normalizes path by ensuring a trailing slash before appending the type directory
        return basePath.endsWith("/") ? basePath + type : basePath + "/" + type;
    }

    /**
     * Closes SFTP channel and session safely[span_6](start_span)[span_6](end_span).
     */
    private void disconnect(ChannelSftp channel, Session session) {
        if (channel != null && channel.isConnected()) {
            channel.disconnect();
            log.debug("SFTP channel disconnected.");
        }
        if (session != null && session.isConnected()) {
            session.disconnect();
            log.debug("SFTP session disconnected.");
        }
    }
}
