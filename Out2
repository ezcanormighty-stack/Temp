import java.security.cert.X509Certificate;
import java.util.ArrayList;
import java.util.Base64;
import java.util.List;

import javax.xml.parsers.DocumentBuilder;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.transform.OutputKeys;
import javax.xml.transform.Transformer;
import javax.xml.transform.TransformerFactory;
import javax.xml.transform.dom.DOMSource;
import javax.xml.transform.stream.StreamResult;

import org.bouncycastle.cert.jcajce.JcaCertStore;
import org.bouncycastle.cms.CMSProcessableByteArray;
import org.bouncycastle.cms.CMSSignedData;
import org.bouncycastle.cms.CMSSignedDataGenerator;
import org.bouncycastle.cms.CMSTypedData;
import org.bouncycastle.cms.jcajce.JcaSignerInfoGeneratorBuilder;
import org.bouncycastle.jce.provider.BouncyCastleProvider;
import org.bouncycastle.operator.ContentSigner;
import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder;
import org.bouncycastle.operator.jcajce.JcaDigestCalculatorProviderBuilder;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Component;
import org.w3c.dom.Document;
import org.w3c.dom.Element;

import com.tcs.npci.outward.config.properties.CryptoProperties;
import com.tcs.npci.outward.constant.AppConstants;
import com.tcs.npci.outward.exception.CryptoOperationException;

import jakarta.annotation.PostConstruct;

@Component
public class SignatureUtility {

    private static final Logger log = LoggerFactory.getLogger(SignatureUtility.class);

    private final CryptoProperties cryptoProperties;
    private PrivateKey privateKey;
    private X509Certificate certificate;
    private String base64Certificate;

    public SignatureUtility(CryptoProperties cryptoProperties) {
        this.cryptoProperties = cryptoProperties;
    }

    @PostConstruct
    public void init() {
        try {
            Security.addProvider(new BouncyCastleProvider());
            
            String keystorePath = cryptoProperties.getKeystore().getPrivateKeyPath();
            String password = cryptoProperties.getKeystore().getPassword();

            // Load PKCS12 Keystore[span_0](start_span)[span_0](end_span)
            KeyStore keyStore = KeyStore.getInstance("PKCS12");
            try (FileInputStream fis = new FileInputStream(keystorePath)) {
                keyStore.load(fis, password.toCharArray());
            }

            String alias = keyStore.aliases().nextElement();
            this.privateKey = (PrivateKey) keyStore.getKey(alias, password.toCharArray());
            
            Certificate cert = keyStore.getCertificate(alias);
            if (cert instanceof X509Certificate) {
                this.certificate = (X509Certificate) cert;
                this.base64Certificate = Base64.getEncoder().encodeToString(this.certificate.getEncoded());
            } else {
                throw new IllegalStateException("Certificate in keystore is not an X509Certificate");
            }
            
            log.info("Signature Utility initialized successfully with private key and certificate.");
        } catch (Exception e) {
            log.error("Failed to initialize Keystore for signing", e);
            throw new RuntimeException("Could not initialize signing keys", e);
        }
    }

    /**
     * Reads the zip, signs it, and writes the XML wrapper to the destination path.
     */
    public void signAndWrapXml(Path inputZipPath, Path outputXmlPath) {
        try {
            byte[] zipBytes = Files.readAllBytes(inputZipPath);
            
            // Generate CMS Signature[span_1](start_span)[span_1](end_span)
            byte[] cmsSignature = signZip(zipBytes);
            
            String base64Zip = Base64.getEncoder().encodeToString(zipBytes);
            String base64Signature = Base64.getEncoder().encodeToString(cmsSignature);
            
            // Generate XML Wrapper[span_2](start_span)[span_2](end_span)
            String xmlContent = generateXml(base64Zip, base64Signature, base64Certificate);
            
            Files.write(outputXmlPath, xmlContent.getBytes(StandardCharsets.UTF_8));
            log.debug("Successfully created signed XML wrapper at {}", outputXmlPath);
            
        } catch (Exception e) {
            throw new CryptoOperationException(AppConstants.TECHNICAL_ERROR.getValue(), "Failed to sign and wrap XML", e);
        }
    }

    /**
     * Creates a CMS signature using BouncyCastle[span_3](start_span)[span_3](end_span).
     */
    private byte[] signZip(byte[] zipBytes) throws Exception {
        CMSTypedData cmsData = new CMSProcessableByteArray(zipBytes);
        CMSSignedDataGenerator generator = new CMSSignedDataGenerator();

        ContentSigner signer = new JcaContentSignerBuilder("SHA256withRSA").setProvider("BC").build(privateKey);

        generator.addSignerInfoGenerator(
                new JcaSignerInfoGeneratorBuilder(new JcaDigestCalculatorProviderBuilder().setProvider("BC").build())
                .build(signer, certificate));

        List<X509Certificate> certList = new ArrayList<>();
        certList.add(certificate);

        generator.addCertificates(new JcaCertStore(certList));

        // DETACHED = false[span_4](start_span)[span_4](end_span)
        CMSSignedData signedData = generator.generate(cmsData, false);
        return signedData.getEncoded();
    }

    /**
     * Constructs the XML envelope containing original content, signature, and certificate[span_5](start_span)[span_5](end_span).
     */
    private String generateXml(String orgContent, String signature, String cert) throws Exception {
        DocumentBuilderFactory dbf = DocumentBuilderFactory.newInstance();
        DocumentBuilder db = dbf.newDocumentBuilder();
        Document doc = db.newDocument();
        
        Element envelope = doc.createElement("Envelope");
        doc.appendChild(envelope);
        
        Element org = doc.createElement("OrgContent");
        org.setTextContent(orgContent);
        envelope.appendChild(org);
        
        Element sig = doc.createElement("Signature");
        sig.setTextContent(signature);
        envelope.appendChild(sig);
        
        Element certificateNode = doc.createElement("Certificate");
        certificateNode.setTextContent(cert);
        envelope.appendChild(certificateNode);
        
        Transformer transformer = TransformerFactory.newInstance().newTransformer();
        transformer.setOutputProperty(OutputKeys.STANDALONE, "yes");
        transformer.setOutputProperty(OutputKeys.INDENT, "yes");
        
        StringWriter writer = new StringWriter();
        transformer.transform(new DOMSource(doc), new StreamResult(writer));
        
        return writer.toString();
    }
}




