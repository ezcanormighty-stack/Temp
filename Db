CREATE TABLE OUTWARD_DEC_LOGS (
    REFERENCE_NUMBER   VARCHAR2(35)  NOT NULL,
    ENTRY_DATE         DATE,
    FILE_NAME          VARCHAR2(100),
    FILE_TYPE          VARCHAR2(20),
    ERROR_CODE         VARCHAR2(10),
    ENCRYPTION_TYPE    VARCHAR2(30),
    TOTAL_RECORDS      NUMBER(10),
    FILE_COPIED_TIME   TIMESTAMP,
    STATUS             VARCHAR2(50),
    STATUS_DEC         VARCHAR2(50),
    LAST_UPDATED_TIME  TIMESTAMP,
    ZONE               VARCHAR2(10),
    CONSTRAINT PK_OUTWARD_DEC_LOGS PRIMARY KEY (REFERENCE_NUMBER)
);

-- Index to speed up the duplicate-file check (existsByFileNameAndErrorCodeIsNull)
CREATE INDEX IDX_OUTWARD_DEC_LOGS_FILE_ERR ON OUTWARD_DEC_LOGS (FILE_NAME, ERROR_CODE);
