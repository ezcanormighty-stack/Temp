package com.tcs.aadesh.entity;

import java.sql.Date;
import java.time.LocalDateTime;
import java.util.Objects;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.IdClass;
import jakarta.persistence.Table;

@Entity
@Table(name = "OUTWARD_FILE_LOGS")
@IdClass(OutwardFileLogId.class)
public class OutwardFileLog {

	@Id
	@Column(name = "FILE_NAME")
	private String fileName;

	@Id
	@Column(name = "LAST_UPDATED_TIME")
	private LocalDateTime lastUpdatedTime;

	@Column(name = "FOLDER_NAME")
	private String folderName;

	@Column(name = "ERROR_CODE")
	private String errorCode;

	@Column(name = "ENTRY_DATE")
	private Date entryDate;

	@Column(name = "PROCESS_TYPE")
	private String processType = "DEC";

	@Column(name = "ZONE")
	private String zone;

	public OutwardFileLog() {
	}

	public String getFileName() { return fileName; }
	public void setFileName(String fileName) { this.fileName = fileName; }

	public LocalDateTime getLastUpdatedTime() { return lastUpdatedTime; }
	public void setLastUpdatedTime(LocalDateTime lastUpdatedTime) { this.lastUpdatedTime = lastUpdatedTime; }

	public String getFolderName() { return folderName; }
	public void setFolderName(String folderName) { this.folderName = folderName; }

	public String getErrorCode() { return errorCode; }
	public void setErrorCode(String errorCode) { this.errorCode = errorCode; }

	public Date getEntryDate() { return entryDate; }
	public void setEntryDate(Date entryDate) { this.entryDate = entryDate; }

	public String getProcessType() { return processType; }
	public void setProcessType(String processType) { this.processType = processType; }

	public String getZone() { return zone; }
	public void setZone(String zone) { this.zone = zone; }

	@Override
	public int hashCode() {
		return Objects.hash(fileName, lastUpdatedTime);
	}

	@Override
	public boolean equals(Object obj) {
		if (this == obj) return true;
		if (obj == null || getClass() != obj.getClass()) return false;
		OutwardFileLog other = (OutwardFileLog) obj;
		return Objects.equals(fileName, other.fileName)
				&& Objects.equals(lastUpdatedTime, other.lastUpdatedTime);
	}
}

